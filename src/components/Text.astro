---
// Renders copy. Anything still in [square brackets] is a note for us, not for guests: it is dropped
// so a placeholder can never reach the live site. Search the data files for "[" to find what's left.
interface Props {
  text: string;
}

const text = Astro.props.text
  .replace(/\s*\[[^\]]*\]/g, '')
  .replace(/\s+([.,])/g, '$1')
  .trim();
---

{text}
