---
// A property photo from src/assets/properties/<slug>/, converted to AVIF and WebP at build.
// If the file hasn't been added yet, shows a labelled placeholder instead of a stock image.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  slug: string;
  file?: string;
  alt: string;
  /** Shown on the placeholder, e.g. the room name. */
  label?: string;
  /** CSS aspect ratio, e.g. '3 / 2'. */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {
  slug,
  file,
  alt,
  label,
  ratio = '3 / 2',
  sizes = '(min-width: 1200px) 600px, 100vw',
  widths = [480, 800, 1200, 1600],
  eager = false,
  class: className,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const src = file ? images[`/src/assets/properties/${slug}/${file}`]?.default : undefined;
---

<figure class:list={['photo', className]} style={`aspect-ratio: ${ratio}`}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[...widths.filter((w) => w < src.width), src.width]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={alt}>
        <img src="/brand/mark.svg" alt="" width="48" height="30" />
        <span>{label ?? 'Photo'}</span>
        <span class="photo__file">Photo to add{file ? `: ${file}` : ''}</span>
      </div>
    )
  }
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--line);
    border-radius: var(--radius);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo :global(picture) {
    height: 100%;
  }

  .photo__placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.25rem;
    height: 100%;
    padding: var(--s2);
    text-align: center;
    color: var(--forest-soft);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .photo__placeholder img {
    width: 48px;
    height: auto;
    margin-bottom: var(--s1);
    opacity: 0.5;
    animation: none;
  }
  .photo__file {
    font-weight: 400;
    font-size: 0.75rem;
  }
</style>
