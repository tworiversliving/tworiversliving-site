---
// A property photo from src/assets/properties/<slug>/, converted to AVIF and WebP at build.
// Fixed aspect ratio, cover crop, no radius. A missing file renders a toned block with the intended
// file name only in dev or when PUBLIC_SHOW_PHOTO_TODOS=true. On the live site it renders nothing,
// so pages wrap their photo slots in a container that collapses when empty (see :empty rules).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  slug: string;
  file?: string;
  alt: string;
  ratio?: '4/5' | '3/2' | '1' | '16/7' | 'auto';
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** fetchpriority="high". Defaults to eager; turn off for eager photos below the fold. */
  priority?: boolean;
  class?: string;
}

const {
  slug,
  file,
  alt,
  ratio = '3/2',
  sizes = '(min-width: 1280px) 640px, 100vw',
  widths = [480, 800, 1200, 1600],
  eager = false,
  priority = eager,
  class: className,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const src = file ? images[`/src/assets/properties/${slug}/${file}`]?.default : undefined;
const showTodo = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PHOTO_TODOS === 'true';
---

{(src || showTodo) && (
<figure class:list={['photo', className]} style={ratio === 'auto' ? undefined : `aspect-ratio: ${ratio}`}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[...widths.filter((w) => w < src.width), src.width]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={alt}>
        {showTodo && <span class="photo__file">{file ?? 'no file set'}</span>}
      </div>
    )
  }
</figure>
)}

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--line);
  }
  .photo :global(picture) {
    height: 100%;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    position: relative;
    height: 100%;
    min-height: 120px;
    background: var(--line);
  }
  .photo__file {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--forest-soft);
  }
</style>
