---
// Horizontal scroll-snap row. Each child is one item; on phones items are 78% wide so the next one peeks.
// The mono counter ("1 / 24") follows the item in view. No carousel library.
interface Props {
  /** Accessible name for the row, e.g. 'Photos of the flat'. */
  label: string;
  /** Item width on phones. */
  itemWidth?: string;
  /** Item width from 900px. Defaults to itemWidth. */
  itemWidthDesktop?: string;
  /** Total shown in the counter when the row holds fewer items than exist, e.g. 24 photos. */
  total?: number;
  counter?: boolean;
  class?: string;
}

const { label, itemWidth = '78%', itemWidthDesktop, total, counter = true, class: className } = Astro.props;
const style = `--item-w: ${itemWidth}; --item-w-d: ${itemWidthDesktop ?? itemWidth}`;
---

<tr-swipe-row class:list={['swipe', className]} style={style} data-total={total}>
  <div class="swipe__track" role="region" aria-label={label} tabindex="0">
    <slot />
  </div>
  {
    counter && (
      <p class="swipe__count mono" aria-hidden="true">
        <span data-current>1</span> / <span data-count>{total ?? ''}</span>
      </p>
    )
  }
</tr-swipe-row>

<script>
  class SwipeRow extends HTMLElement {
    observer?: IntersectionObserver;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.swipe__track');
      const current = this.querySelector<HTMLElement>('[data-current]');
      const count = this.querySelector<HTMLElement>('[data-count]');
      if (!track) return;
      const items = Array.from(track.children) as HTMLElement[];
      if (count) count.textContent = String(this.dataset.total || items.length);
      if (!current) return;

      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) current.textContent = String(items.indexOf(entry.target as HTMLElement) + 1);
          }
        },
        { root: track, threshold: 0.6 },
      );
      items.forEach((item) => this.observer!.observe(item));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  customElements.define('tr-swipe-row', SwipeRow);
</script>

<style>
  .swipe {
    display: block;
  }

  .swipe__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    scrollbar-width: none;
  }
  .swipe__track::-webkit-scrollbar {
    display: none;
  }
  .swipe__track > :global(*) {
    flex: 0 0 var(--item-w);
    min-width: 0;
    scroll-snap-align: start;
  }
  @media (min-width: 900px) {
    .swipe__track > :global(*) {
      flex-basis: var(--item-w-d);
    }
  }

  .swipe__count {
    margin: 12px 0 0;
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    color: var(--forest-soft);
  }
</style>
