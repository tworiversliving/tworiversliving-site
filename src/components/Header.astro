---
import { nav, site } from '../config/site';
import { properties } from '../data/properties';
import { todo } from '../data/todo';
import Button from './ui/Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
// Opens the date picker (DateSheet.astro). Without JavaScript it goes to the booking card.
const checkDates = `/stays/${properties[0].slug}#book`;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label={`${site.name}, home`}>
      <img src="/brand/logo-horizontal.svg" alt="" width="160" height="35" />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={checkDates} class="header__cta" data-open-dates>Check dates</Button>

    <button class="round header__toggle" type="button" aria-label="Menu" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>

  <dialog class="menu" id="menu" aria-label="Menu" data-menu>
    <div class="menu__inner">
      <div class="menu__top">
        <a href="/" class="header__logo" aria-label={`${site.name}, home`}>
          <img src="/brand/logo-horizontal.svg" alt="" width="160" height="35" />
        </a>
        <button class="round" type="button" aria-label="Close menu" data-menu-close>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>

      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="menu__contact mono">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {todo.whatsappHref && <a href={todo.whatsappHref}>WhatsApp {todo.whatsapp}</a>}
      </p>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (menu && openBtn) {
    const root = document.documentElement;
    openBtn.addEventListener('click', () => {
      menu.showModal();
      root.classList.add('menu-open');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // Links to an anchor on the same page should still close the panel
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    menu.addEventListener('close', () => root.classList.remove('menu-open'));
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && menu.open && menu.close());
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s4);
    height: var(--header-h);
  }

  .header__logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    margin-right: auto;
  }
  .header__logo img {
    width: 148px;
    height: auto;
  }

  .header__nav {
    display: none;
  }
  .header__nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 44px tall for the tap target; the underline sits under the text, not at the box edge */
  .header__nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline transparent;
    text-underline-offset: 6px;
    font-size: var(--t-small);
    font-weight: 500;
  }
  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    text-decoration-color: var(--forest);
    color: var(--ink);
  }

  .header :global(.header__cta) {
    display: none;
  }

  .round {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--forest);
    cursor: pointer;
  }
  .round:hover {
    border-color: var(--forest);
  }

  @media (min-width: 1024px) {
    .header__logo img {
      width: 160px;
    }
    .header__nav,
    .header :global(.header__cta) {
      display: flex;
    }
    .header__toggle {
      display: none;
    }
  }

  /* Phone menu: full-screen paper panel */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .menu::backdrop {
    background: var(--paper);
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0 max(var(--gutter), env(safe-area-inset-right)) max(var(--s4), env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
  }
  .menu__top {
    display: flex;
    align-items: center;
    height: var(--header-h);
    margin-bottom: var(--s4);
  }

  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .menu li {
    border-bottom: 1px solid var(--line);
  }
  .menu li a {
    display: block;
    padding-block: 14px;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.1;
    color: var(--forest);
    text-decoration: none;
  }
  /* Same face as the other items; the current page is marked by colour only */
  .menu li a[aria-current='page'] {
    color: var(--brass-deep);
  }

  .menu__contact {
    display: grid;
    margin: auto 0 0;
    padding-top: var(--s6);
  }
  .menu__contact a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--forest-soft);
    text-decoration: none;
  }
</style>
