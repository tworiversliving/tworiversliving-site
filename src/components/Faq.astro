---
import type { Faq } from '../data/faq';
import Text from './Text.astro';

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>
          <Text text={item.a} />
        </p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s2);
    padding: var(--s3) 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex-shrink: 0;
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--brass-deep);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    max-width: 40em;
    padding-bottom: var(--s3);
    margin: 0;
    color: var(--forest-soft);
  }
</style>
