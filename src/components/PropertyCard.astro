---
import type { Property } from '../data/properties';
import Photo from './Photo.astro';

interface Props {
  property: Property;
}

const { property: p } = Astro.props;
const card = p.photos.find((ph) => ph.file === p.cardPhoto);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<article class="card" data-property={p.slug}>
  <a href={`/stays/${p.slug}`} class="card__link">
    <Photo slug={p.slug} file={card?.file} alt={card?.alt ?? p.name} label={card?.room} sizes="(min-width: 960px) 580px, 100vw" />
    <div class="card__body">
      <span class="kicker">{p.area}</span>
      <h3 class="card__name">{p.name}</h3>
      <p class="muted small">
        {plural(p.guests, 'guest')} · {plural(p.bedrooms, 'bedroom')} · {plural(p.bathrooms, 'bathroom')}
      </p>
      <p class="card__price" data-price>
        From <strong>£{p.fromPriceFallback}</strong> a night
      </p>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card :global(.photo) {
    border-radius: 0;
  }
  .card__body {
    padding: var(--s3);
  }
  .card__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    margin-bottom: var(--s1);
  }
  .card__link:hover .card__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .card__price {
    margin: 0;
  }
</style>
