---
// Dates, guests and live price for a property. The dates open the shared picker (DateSheet.astro).
// Reserve goes to /book/<slug>; stays over the instant-booking limit go to the long stay enquiry with the dates carried across.
import { booking } from '../config/booking';
import { site } from '../config/site';
import type { Property } from '../data/properties';
import DatePair from './DatePair.astro';

interface Props {
  property: Property;
}

const { property: p } = Astro.props;
---

<aside class="panel" id="book" aria-label="Book this flat" data-panel data-slug={p.slug} data-max-instant={booking.maxInstantNights} data-max-nights={booking.maxNights}>
  <p class="panel__price"><span class="panel__amount" data-from-price>£{p.fromPriceFallback}</span> a night, from</p>

  <DatePair context="book" align="end" class="panel__dates" />

  <div class="field guests">
    <label for="guests">Guests</label>
    <select id="guests" data-guests>
      {Array.from({ length: p.guests }, (_, i) => <option value={i + 1} selected={i + 1 === 2}>{i + 1}</option>)}
    </select>
  </div>

  <dl class="breakdown" data-breakdown hidden></dl>
  <p class="error small" data-error role="alert" hidden></p>

  <button type="button" class="button button--block panel__reserve" data-reserve disabled>Reserve</button>
  <p class="panel__note">
    <span data-under>You won't be charged until the next step.</span>
    <span data-long-note>Staying {booking.maxInstantNights + 1} nights or more? <a href="/work-stays#quote">Ask for a quote</a>.</span>
  </p>

  <div data-fallback hidden>
    <p class="panel__note">We couldn't load the calendar just now. Email us your dates and we'll confirm the price.</p>
    <a class="button button--block button--secondary" href={`mailto:${site.email}?subject=${encodeURIComponent(`Dates for ${p.name}`)}`}>Email us your dates</a>
  </div>
  <noscript>
    <p class="panel__note">Turn on JavaScript to see live dates, or email us at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </noscript>
</aside>

<script>
  import { gbp, plural, postJson } from '../scripts/booking';
  import { addDays, horizonFrom, isIso, isValidCheckout, loadAvailability, nightsBetween, stay } from '../scripts/dates';

  interface Quote {
    ok: boolean;
    mode: 'instant' | 'enquire' | null;
    errors: string[];
    nightCount: number;
    subtotal: number;
    discount: number;
    stay: number;
    discountRate: number;
  }

  const panel = document.querySelector<HTMLElement>('[data-panel]');
  if (panel) init(panel);

  function init(panel: HTMLElement) {
    const $ = <T extends HTMLElement>(sel: string) => panel.querySelector<T>(sel)!;
    const slug = panel.dataset.slug!;
    const maxInstant = Number(panel.dataset.maxInstant);
    const maxNights = Number(panel.dataset.maxNights);
    const guestsEl = $<HTMLSelectElement>('[data-guests]');
    const breakdown = $('[data-breakdown]');
    const errorEl = $('[data-error]');
    const reserve = $<HTMLButtonElement>('[data-reserve]');
    const under = $('[data-under]');
    const longNote = $('[data-long-note]');
    let quoteSeq = 0;
    let target = '';

    // The card, the date sheet and the popover share one stay
    stay.set({ guests: Number(guestsEl.value) });
    guestsEl.addEventListener('change', () => stay.set({ guests: Number(guestsEl.value) }));
    let last = '';
    stay.subscribe((s) => {
      if (guestsEl.value !== String(s.guests)) guestsEl.value = String(s.guests);
      const key = `${s.checkIn}|${s.checkOut}|${s.guests}`;
      if (key !== last) {
        last = key;
        update();
      }
    });

    function fail(text: string) {
      errorEl.textContent = text;
      errorEl.hidden = false;
    }

    async function update() {
      const { checkIn, checkOut, guests } = stay.get();
      errorEl.hidden = true;
      breakdown.hidden = true;
      reserve.disabled = true;
      reserve.textContent = 'Reserve';
      under.textContent = "You won't be charged until the next step.";
      longNote.hidden = false;
      const seq = ++quoteSeq;
      if (!checkIn || !checkOut) return;
      const params = new URLSearchParams({ checkIn, checkOut, guests: String(guests) });
      history.replaceState(null, '', `${location.pathname}?${params}${location.hash}`);
      const n = nightsBetween(checkIn, checkOut);
      if (n > maxNights) return fail(`We can't take stays over ${maxNights} nights.`);
      if (n > maxInstant) {
        reserve.textContent = 'Ask for a quote';
        under.textContent = `Stays over ${maxInstant} nights are quoted for the whole flat.`;
        longNote.hidden = true;
        target = `/work-stays?${params}#quote`;
        reserve.disabled = false;
        return;
      }
      const q = await postJson<Quote>('/api/quote', { slug, checkIn, checkOut, guests });
      if (seq !== quoteSeq) return;
      if (!q.ok) return fail(q.errors?.[0] ?? q.error ?? 'Those dates are not available.');
      breakdown.innerHTML = [
        `<div><dt>${plural(n, 'night')}</dt><dd>${gbp(q.subtotal)}</dd></div>`,
        q.discount ? `<div><dt>Direct booking discount (${Math.round(q.discountRate * 100)}%)</dt><dd>−${gbp(q.discount)}</dd></div>` : '',
        `<div><dt>Booking and cleaning fees</dt><dd>£0</dd></div>`,
        `<div class="breakdown__total"><dt>Total</dt><dd>${gbp(q.stay)}</dd></div>`,
      ].join('');
      breakdown.hidden = false;
      target = `/book/${slug}?${params}`;
      reserve.disabled = false;
    }
    reserve.addEventListener('click', () => target && (location.href = target));

    loadAvailability(slug).then((av) => {
      if (!av) {
        $('[data-fallback]').hidden = false;
        return;
      }
      const today = av.today;
      // "From" price: the lowest direct rate over the next 60 days.
      const soon = [...av.days.values()].filter((d) => d.available && d.price != null && d.date < addDays(today, 60)).map((d) => d.price!);
      if (soon.length) document.querySelectorAll('[data-from-price]').forEach((el) => (el.textContent = gbp(Math.min(...soon))));

      // Dates carried back from the checkout page or a shared link.
      const qs = new URLSearchParams(location.search);
      const ci = qs.get('checkIn');
      const co = qs.get('checkOut');
      const g = qs.get('guests');
      const patch: Parameters<typeof stay.set>[0] = {};
      if (g && guestsEl.querySelector(`option[value="${g}"]`)) patch.guests = Number(g);
      if (isIso(ci) && ci >= today) {
        patch.checkIn = ci;
        patch.checkOut = isIso(co) && isValidCheckout(av, ci, co, horizonFrom(today), maxInstant) ? co : null;
      }
      stay.set(patch);
    });
  }
</script>

<style>
  /* The only bordered box on the site (BRIEF.md 2.4) */
  .panel {
    align-self: start;
    padding: 28px;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--forest);
    border-radius: var(--r-card);
  }
  @media (max-width: 400px) {
    .panel {
      padding: 22px 20px;
    }
  }
  @media (min-width: 900px) {
    .panel {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  .panel__price {
    margin: 0 0 var(--s3);
    color: var(--text-3);
  }
  .panel__amount {
    margin-right: 4px;
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--forest);
  }

  .panel__dates {
    margin-bottom: 12px;
  }

  .guests {
    margin-bottom: var(--s3);
    padding-top: 6px;
  }
  .guests label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--forest-soft);
  }

  /* Mono figures, ruled like a schedule */
  .breakdown {
    margin: 0 0 var(--s3);
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
  }
  .breakdown :global(div) {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .breakdown :global(dt) {
    color: var(--text-3);
  }
  .breakdown :global(dd) {
    margin: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .breakdown :global(.breakdown__total) {
    border-bottom: 0;
    font-size: 0.9375rem;
  }
  .breakdown :global(.breakdown__total dt) {
    color: var(--ink);
  }

  .panel__note {
    margin: 12px 0 0;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--text-3);
  }
  .panel__note [hidden] {
    display: none;
  }

  .error {
    margin: 0 0 var(--s2);
    color: var(--error);
  }
  .button:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>
