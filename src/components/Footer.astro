---
import { site } from '../config/site';
import { properties } from '../data/properties';

const columns = [
  {
    title: 'Stay',
    links: [
      { href: '/stays', label: 'All stays' },
      ...properties.map((p) => ({ href: `/stays/${p.slug}`, label: p.area })),
      { href: '/work-stays', label: 'Work and long stays' },
      { href: '/book-direct', label: 'Why book direct' },
      { href: '/booking', label: 'Manage a booking' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/areas/stoke-newington', label: 'Stoke Newington guide' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Booking terms' },
      { href: '/house-rules', label: 'House rules' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/cookies', label: 'Cookies' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label={`${site.name}, home`}>
          <img src="/brand/logo-stacked-light.svg" alt="" width="140" height="103" />
        </a>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.phoneHref ? <a href={site.phoneHref}>{site.phone}</a> : <span class="todo">[phone number to add]</span>}
        </p>
        <p class="small">{site.responseTime}</p>
      </div>

      {
        columns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="kicker">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="footer__legal small">
      {site.legalName}. Registered in England and Wales, company no. {site.companyNumber}. Registered office: {site.registeredOffice}.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest);
    color: var(--mist);
    padding-block: var(--s8) var(--s4);
  }
  .footer a {
    color: var(--mist);
    text-decoration: none;
  }
  .footer a:hover {
    text-decoration: underline;
  }

  .footer__top {
    display: grid;
    gap: var(--s5);
  }
  @media (min-width: 640px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .footer__brand img {
    width: 140px;
    height: auto;
    margin-bottom: var(--s3);
  }
  .footer__brand .small {
    opacity: 0.8;
  }

  .footer .kicker {
    /* Brass fails contrast for small text on forest, so labels stay mist here */
    color: var(--mist);
    opacity: 0.7;
    font-size: 0.75rem;
  }
  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer li {
    margin-bottom: var(--s1);
  }

  .footer .todo {
    color: var(--mist);
  }

  .footer__legal {
    margin: var(--s8) 0 0;
    padding-top: var(--s3);
    border-top: 1px solid var(--line-dark);
    opacity: 0.8;
  }
</style>
