---
import { site } from '../config/site';
import { properties } from '../data/properties';
import { todo } from '../data/todo';

const columns = [
  {
    title: 'Stay',
    links: [
      ...properties.map((p) => ({ href: `/stays/${p.slug}`, label: 'The flat' })),
      { href: '/work-stays', label: 'Work and long stays' },
      { href: '/book-direct', label: 'Why book direct' },
      { href: '/booking', label: 'Manage a booking' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/areas/stoke-newington', label: 'Stoke Newington guide' },
      { href: '/faq', label: 'Questions' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Booking terms' },
      { href: '/house-rules', label: 'House rules' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/cookies', label: 'Cookies' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__wordmark">{site.name}</a>
        <p class="mono footer__contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {todo.whatsappHref && <a href={todo.whatsappHref}>WhatsApp {todo.whatsapp}</a>}
        </p>
        <p class="footer__note">{site.responseTime}</p>
      </div>

      {
        columns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="label label--on-forest">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="footer__legal mono">{site.legalName} · London</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--on-forest);
    padding-block: var(--s8) max(var(--s4), env(safe-area-inset-bottom));
  }
  .footer a {
    color: var(--on-forest);
    text-decoration: none;
  }
  .footer a:hover {
    text-decoration: underline;
  }

  .footer__top {
    display: grid;
    gap: var(--s5) var(--s4);
    grid-template-columns: 1fr 1fr;
  }
  .footer__brand {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .footer__brand {
      grid-column: auto;
    }
  }

  .footer__wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: var(--s3);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.1;
  }
  .footer__contact {
    display: grid;
    justify-items: start;
    margin-bottom: var(--s2);
  }
  .footer__note {
    margin: 0;
    font-size: var(--t-small);
    color: var(--on-forest-2);
  }

  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer li {
    font-size: var(--t-small);
  }
  .footer li a,
  .footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__legal {
    margin: var(--s8) 0 0;
    padding-top: var(--s3);
    border-top: 1px solid var(--line-dark);
    color: var(--on-forest-2);
  }
</style>
