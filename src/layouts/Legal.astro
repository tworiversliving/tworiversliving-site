---
// Shared shell for /terms, /privacy, /cookies and /house-rules.
// Drafted in plain English from PLAN.md's legal checklist. Not legal advice: have a solicitor read them once before launch.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  kicker?: string;
  /** ISO date the page last changed in substance. */
  updated: string;
  intro?: string;
}

const { title, description, kicker = 'Legal', updated, intro } = Astro.props;
const updatedText = new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });
---

<Base title={title} description={description}>
  <div class="container page-head">
    <p class="label">{kicker}</p>
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <p class="mono updated">Last updated {updatedText}</p>
  </div>

  <div class="section section--ruled">
    <article class="container legal">
      <slot />
    </article>
  </div>
</Base>

<style>
  .page-head .updated {
    margin: var(--s3) 0 0;
    font-size: var(--t-mono);
    color: var(--forest-soft);
  }
  .legal {
    color: var(--text-2);
  }
  .legal > :global(*) {
    max-width: 44em;
  }
  .legal :global(p),
  .legal :global(ul) {
    max-width: var(--measure);
  }
  .legal :global(h2) {
    margin-top: var(--s8);
    font-size: var(--t-h3);
    line-height: 1.1;
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(h3) {
    margin-top: var(--s4);
    font-size: var(--t-body);
    color: var(--ink);
  }
  .legal :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }
  .legal :global(ul) {
    padding-left: 1.25em;
  }
  .legal :global(li) {
    margin-bottom: var(--s1);
  }
  .legal :global(table) {
    width: 100%;
    margin-bottom: var(--s3);
    border-collapse: collapse;
    border-top: 1px solid var(--line-strong);
    font-size: var(--t-small);
  }
  .legal :global(th),
  .legal :global(td) {
    padding: 10px var(--s2) 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .legal :global(th) {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--forest-soft);
  }
  /* Tables scroll sideways on small screens rather than squashing */
  .legal :global(.table) {
    overflow-x: auto;
  }
</style>
