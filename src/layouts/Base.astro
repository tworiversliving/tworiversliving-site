---
// Only the weights in docs/redesign/BRIEF.md 2.1, Latin subset
import '@fontsource/redaction/latin-400.css';
import '@fontsource/redaction/latin-400-italic.css';
import '@fontsource/redaction-50/latin-400.css';
import '@fontsource/host-grotesk/latin-400.css';
import '@fontsource/host-grotesk/latin-500.css';
import '@fontsource/fragment-mono/latin-400.css';
import redaction400 from '@fontsource/redaction/files/redaction-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DateSheet from '../components/DateSheet.astro';
import { site } from '../config/site';
import { ogImage, type PhotoRef } from '../lib/og';
import { breadcrumbs, organization } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Photo for the social share image. Defaults to the first property's ogPhoto. */
  ogPhoto?: PhotoRef;
  /** A ready-made 1200×630 card in public/ (scripts/og-card.mjs). Takes the place of ogPhoto. */
  ogCard?: { src: string; alt: string };
  /** Extra JSON-LD for this page (Organization and breadcrumbs are added here). */
  schema?: object[];
  /** Trail after Home. Defaults to this page alone. */
  crumbs?: { name: string; path: string }[];
}

const { title, description, noindex = false, ogPhoto, ogCard, schema = [], crumbs } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const robots = noindex || !site.indexable ? 'noindex, nofollow' : 'index, follow';
const og = ogCard ? { ...ogCard, width: 1200, height: 630 } : await ogImage(ogPhoto);

const path = new URL(canonical).pathname;
const jsonLd = [organization(), ...(path !== '/' && !noindex ? [breadcrumbs(crumbs ?? [{ name: title, path }])] : []), ...schema];
// Stops a "</script>" inside any string from closing the tag early.
const ld = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAFAF6" />
    <link rel="preload" href={redaction400} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {
      og && (
        <>
          <meta property="og:image" content={new URL(og.src, site.url).href} />
          <meta property="og:image:width" content={String(og.width)} />
          <meta property="og:image:height" content={String(og.height)} />
          <meta property="og:image:alt" content={og.alt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={ld(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DateSheet />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    left: var(--s2);
    top: -100px;
    z-index: 100;
    padding: var(--s1) var(--s2);
    background: var(--forest);
    color: var(--mist);
    border-radius: var(--r-pill);
  }
  .skip:focus {
    top: var(--s2);
  }
</style>
