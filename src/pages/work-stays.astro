---
import Base from '../layouts/Base.astro';
import Photo from '../components/ui/Photo.astro';
import Button from '../components/ui/Button.astro';
import Schedule from '../components/ui/Schedule.astro';
import Accordion from '../components/ui/Accordion.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { booking } from '../config/booking';
import { properties } from '../data/properties';
import { faqGroups } from '../data/faq';
import { todo } from '../data/todo';

const p = properties[0];
const photo = (file: string) => ({ file, alt: p.photos.find((ph) => ph.file === file)?.alt ?? '' });
const workspace = photo('workspace.jpg');
const kitchen = photo('kitchen.jpg');

const terms = [
  { key: 'Whole flat', value: 'One booker, one agreement' },
  { key: 'Invoices', value: 'In your company name' },
  { key: 'Bills', value: 'Included' },
  { key: 'Minimum', value: `${booking.maxInstantNights + 1} nights` },
  { key: 'Maximum', value: `${booking.maxNights} nights` },
  { key: 'Reply', value: 'Within a few hours, 8am to 10pm' },
];

const audiences = [
  { who: 'Contractors and site teams', line: 'Three private rooms under one roof, with a kitchen to cook in after a long day.' },
  { who: 'Relocation and insurance placements', line: 'A whole home with a washing machine and space to settle while you sort the next step.' },
  { who: 'NHS and healthcare staff', line: 'A quiet base for placements and rotations, with self check-in at any hour.' },
  { who: 'Film and TV crews', line: 'Room for a small crew, a short train ride from central London.' },
];

const included = [
  'The whole flat, with one booker and one agreement',
  'Three private double bedrooms',
  todo.wifiSpeed ? `A desk and chair, with wifi throughout tested at ${todo.wifiSpeed}` : 'A desk and chair, with wifi throughout',
  'Full kitchen and a washing machine',
  'Bills included',
  'Cleaning and fresh linen as often as you need',
  'Parking permit available',
];

const steps = ['Send your dates and headcount.', 'Get a quote for the whole stay.', 'Pay by card or invoice.', 'Check yourself in with the lockbox.'];

const bookerFaq = [
  { q: 'Are there stairs?', a: 'Yes. The front door is up a flight of stairs and there is no lift.' },
  { q: 'Is there parking?', a: 'We can arrange a visitor permit for the resident bays nearby. It is a permit, not a private space.' },
  ...(faqGroups.find((g) => g.title === 'Work stays')?.items ?? []),
];
---

<Base
  title="Work and long stays"
  description="A whole three-bedroom flat in Stoke Newington for contractors, placements and crews. Longer stays on request, invoiced to your company."
  ogPhoto={{ slug: p.slug, file: 'bedroom-1.jpg' }}
>
  <section class="container page-head work-head">
    <p class="label">Work and long stays</p>
    <h1>
      <span>Three bedrooms in N16,</span>
      <span class="worn">ready for your team.</span>
    </h1>
    <p>The whole flat, three private bedrooms, for longer stays on request.</p>
    <Button href="#quote">Request a quote</Button>
  </section>

  <section class="section section--ruled" aria-labelledby="terms-title">
    <div class="container split">
      <h2 id="terms-title">The terms</h2>
      <Schedule rows={terms} />
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="container who">
      <Photo slug={p.slug} file={workspace.file} alt={workspace.alt} ratio="4/5" sizes="(min-width: 900px) 440px, 100vw" class="who__photo" />
      <div>
        <h2 id="who-title">Who it's for</h2>
        <ul class="who__list">
          {
            audiences.map((a) => (
              <li>
                <h3>{a.who}</h3>
                <p>{a.line}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-label="What's included and how it works">
    <div class="container two">
      <div>
        <h2 class="h3">What's included</h2>
        <ul class="ticks">
          {included.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="h3">How it works</h2>
        <ol class="steps">
          {steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </div>
    <div class="container">
      <Photo slug={p.slug} file={kitchen.file} alt={kitchen.alt} ratio="16/7" sizes="(min-width: 1280px) 1280px, 100vw" class="wide" />
    </div>
  </section>

  <section class="section section--mist" id="quote" aria-labelledby="quote-title">
    <div class="container split">
      <div>
        <h2 id="quote-title">Tell us what you need</h2>
        <p class="lead">We'll come back to you quickly with a price for the whole stay.</p>
      </div>
      <EnquiryForm type="work" />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split">
      <h2 id="faq-title">Questions from bookers</h2>
      <Accordion items={bookerFaq} />
    </div>
  </section>
</Base>

<style>
  .work-head h1 {
    max-width: none;
  }
  .work-head h1 span {
    display: block;
  }
  .work-head p:not(.label) {
    margin-bottom: var(--s4);
  }

  .who {
    display: grid;
    gap: var(--s5);
  }
  .who__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .who__list li {
    padding-block: var(--s3);
    border-bottom: 1px solid var(--line);
  }
  .who__list h3 {
    margin-bottom: 4px;
    font-size: var(--t-body);
    color: var(--ink);
  }
  .who__list p {
    max-width: 30em;
    margin: 0;
    color: var(--text-3);
  }
  @media (min-width: 900px) {
    .who {
      grid-template-columns: 5fr 7fr;
      gap: var(--s8);
      align-items: start;
    }
  }

  .two {
    display: grid;
    gap: var(--s6);
  }
  @media (min-width: 900px) {
    .two {
      grid-template-columns: 1fr 1fr;
      gap: var(--s8);
    }
  }
  .two h2 {
    margin-bottom: var(--s3);
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    border-top: 1px solid var(--line-strong);
  }
  .steps li {
    counter-increment: step;
    display: flex;
    gap: var(--s2);
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    min-width: 2em;
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--brass-deep);
  }
  /* Photo is a child component, so its class needs :global. 16/7 is a sliver on a phone: 3/2 there. */
  :global(.wide) {
    margin-top: var(--s6);
  }
  @media (max-width: 899.98px) {
    :global(.wide) {
      aspect-ratio: 3 / 2 !important;
    }
  }
  @media (min-width: 900px) {
    :global(.wide) {
      margin-top: var(--s8);
    }
  }
</style>
