---
import Base from '../layouts/Base.astro';
import Photo from '../components/ui/Photo.astro';
import Accordion from '../components/ui/Accordion.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Text from '../components/Text.astro';
import { properties } from '../data/properties';
import { faqGroups } from '../data/faq';

const p = properties[0];
const doors = p.photos.find((ph) => ph.file === 'bedroom-doors.jpg') ?? p.photos.find((ph) => ph.room === 'Workspace');

const audiences = [
  { who: 'Contractors and site teams', line: 'Three private rooms under one roof, with a kitchen to cook in after a long day.' },
  { who: 'Relocation and insurance placements', line: 'A whole home with a washing machine and space to settle while you sort the next step.' },
  { who: 'NHS and healthcare staff', line: 'A quiet base for placements and rotations, with self check-in at any hour.' },
  { who: 'Film and TV crews', line: 'Room for a small crew, a short train ride from central London.' },
];

const included = [
  'The whole flat, with one booker and one agreement',
  'Three private double bedrooms',
  'A desk and chair, with wifi throughout [add measured speed]',
  'Full kitchen and a washing machine',
  'Bills included',
  'Cleaning and fresh linen as often as you need',
  'Parking permit available',
];

const steps = [
  'Send your dates and headcount.',
  'Get a quote for the whole stay.',
  'Pay by card or invoice.',
  'Check yourself in with the lockbox.',
];

const bookerFaq = [
  { q: 'Are there stairs?', a: 'Yes. The front door is up a flight of stairs and there is no lift.' },
  { q: 'Is there parking?', a: 'We can arrange a visitor permit for the resident bays nearby. It is a permit, not a private space.' },
  ...(faqGroups.find((g) => g.title === 'Work stays')?.items ?? []),
];
---

<Base
  title="Work and long stays"
  description="A whole three-bedroom flat in Stoke Newington for contractors, placements and crews. Longer stays on request, invoiced to your company."
  ogPhoto={{ slug: properties[0].slug, file: 'bedroom-1.jpg' }}
>
  <section class="hero container">
    <div class="hero__text">
      <span class="kicker">Work and long stays</span>
      <h1>A base for work in North London.</h1>
      <p class="lead">The whole flat, three private bedrooms, for longer stays on request.</p>
      <a href="#quote" class="button">Request a quote</a>
    </div>
    <Photo slug={p.slug} file={doors?.file} alt={doors?.alt ?? ''} eager sizes="(min-width: 960px) 600px, 100vw" />
  </section>

  <section class="section">
    <div class="container">
      <h2>Who it's for</h2>
      <ul class="who">
        {
          audiences.map((a) => (
            <li>
              <h3>{a.who}</h3>
              <p class="muted">{a.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <h2>What's included</h2>
        <ul class="ticks">
          {included.map((i) => <li><Text text={i} /></li>)}
        </ul>
      </div>
      <div>
        <h2>How it works</h2>
        <ol class="steps">
          {steps.map((s) => <li><Text text={s} /></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="quote">
    <div class="container narrow">
      <span class="kicker">Request a quote</span>
      <h2>Tell us what you need</h2>
      <p class="muted">We'll come back to you quickly with a price for the whole stay.</p>
      <EnquiryForm type="work" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Questions from bookers</h2>
      <Accordion items={bookerFaq} />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--s5);
    align-items: center;
    padding-top: calc(var(--header-h) + var(--s6));
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: var(--s8);
    }
  }
  .hero h1 {
    font-size: var(--text-3xl);
  }

  .who {
    display: grid;
    gap: var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .who {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s4) var(--s6);
    }
  }
  @media (min-width: 1100px) {
    .who {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .who li {
    padding-top: var(--s3);
    border-top: 1px solid var(--brass);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: flex;
    gap: var(--s2);
    padding-block: var(--s2);
    border-bottom: 1px solid var(--line);
  }
  .steps li::before {
    content: counter(step);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--brass-deep);
    min-width: 1.5em;
  }
</style>
