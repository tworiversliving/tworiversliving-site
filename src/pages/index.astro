---
import Base from '../layouts/Base.astro';
import Photo from '../components/ui/Photo.astro';
import Label from '../components/ui/Label.astro';
import Button from '../components/ui/Button.astro';
import Schedule from '../components/ui/Schedule.astro';
import SwipeRow from '../components/ui/SwipeRow.astro';
import Accordion from '../components/ui/Accordion.astro';
import StickyBar from '../components/StickyBar.astro';
import { booking } from '../config/booking';
import { site } from '../config/site';
import { properties, ratingLine } from '../data/properties';
import { homeFaqs } from '../data/faq';
import { todo } from '../data/todo';

const flat = properties[0];
const flatHref = `/stays/${flat.slug}`;
// "Check dates" opens the date sheet; without JavaScript it goes to the booking card.
const checkDates = `${flatHref}#book`;
const price = flat.fromPriceFallback;

// Each photo appears once on this page. No TV shots above the fold (BRIEF.md 3).
const photo = (file: string) => {
  const p = flat.photos.find((ph) => ph.file === file);
  return { file, alt: p?.alt ?? '' };
};
const hero = photo('living-room-detail.jpg');
const bedroom = photo('bedroom-1.jpg');
// Only files that exist, so the count matches the property page's "All N photos"
const files = import.meta.glob('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}');
const photoCount = flat.photos.filter((ph) => `/src/assets/properties/${flat.slug}/${ph.file}` in files).length;
const strip = ['dining.jpg', 'kitchen-detail.jpg', 'bedroom-3-detail.jpg', 'workspace.jpg'].map(photo);
const churchStreet = photo('church-street.jpg');
const park = photo('clissold-park.jpg');
// No hosts, Church Street or park photo yet: those slots are left out of the live page until the files exist.
const hosts = { file: 'hosts.jpg', alt: `${site.hosts}, the hosts` };

const sleeping = flat.sleeping.map((s) => ({ key: s.room, value: s.bed }));
const flatRows = [
  ...sleeping,
  { key: 'Bathroom', value: [`${flat.bathrooms}`, todo.showerOrBath.toLowerCase()].filter(Boolean).join(', ') },
  { key: 'Workspace', value: ['Desk and chair', todo.wifiSpeed && `wifi tested at ${todo.wifiSpeed}`].filter(Boolean).join(', ') },
  { key: 'Kitchen', value: 'Full kitchen, dining table for everyone' },
  { key: 'Laundry', value: 'Washing machine' },
  { key: 'Access', value: 'Top floor, stairs to the front door, no lift' },
];

// Bus routes are still a TODO: the row hides until it is filled in.
// Share card from scripts/og-card.mjs (BRIEF.md 4.5)
const ogCard = { src: '/og/stoke-newington.png', alt: `Stoke Newington, kept local. ${flat.guests} guests, ${flat.bedrooms} bedrooms, with the dining table.` };

const distances = [
  ...flat.walkingTimes.map((w) => ({ key: w.place, value: w.time })),
  { key: 'Buses', value: todo.busRoutes },
];
---

<Base
  title={site.name}
  description="Book a three-bedroom flat in Stoke Newington direct with the hosts. Lower prices than the booking platforms, no booking fees, for short breaks and work trips."
  ogCard={ogCard}
>
  <div class="home">
    <section class="hero" id="hero">
      <div class="container">
        <div class="hero__stage">
          <h1 class="hero__title">
            <span>Stoke Newington,</span>
            <span class="worn">kept local.</span>
          </h1>
          <Photo
            slug={flat.slug}
            file={hero.file}
            alt={hero.alt}
            ratio="4/5"
            sizes="(min-width: 1440px) 820px, (min-width: 900px) 62vw, 100vw"
            widths={[480, 800, 1086]}
            eager
            class="hero__photo"
          />
        </div>

        <div class="hero__row">
          <p class="lead hero__intro">A three-bedroom flat a minute from Church Street, for short breaks and work trips.</p>
          <Schedule
            variant="inline"
            class="hero__facts"
            rows={[
              { key: 'Sleeps', value: `${flat.guests} · three doubles + sofa bed` },
              { key: 'Church St', value: '1 min walk' },
              { key: 'Liverpool St', value: '15 min by train' },
              { key: 'Fees', value: 'none, the price is the price' },
              { key: 'Rated', value: ratingLine(flat) },
            ]}
          />
          <Button href={checkDates} variant="price" sub={`from £${price} a night`} class="hero__cta" data-open-dates>Check dates</Button>
        </div>
      </div>
    </section>

    <section class="section flat" aria-labelledby="flat-title">
      <div class="container flat__grid">
        <Photo slug={flat.slug} file={bedroom.file} alt={bedroom.alt} ratio="4/5" sizes="(min-width: 900px) 520px, 100vw" class="flat__photo" />
        <div class="flat__text">
          <Label>The flat</Label>
          <h2 id="flat-title">Three doubles, one long table and a <em>real</em> desk.</h2>
          <p class="lead">{flat.overview[0]}</p>
          <Schedule rows={flatRows} />
          <p class="flat__more"><a class="text-link" href={flatHref}>See the whole flat</a></p>
        </div>
      </div>

      <div class="strip">
        <SwipeRow label="More photos of the flat">
          {strip.map((p) => <Photo slug={flat.slug} file={p.file} alt={p.alt} ratio="4/5" sizes="(min-width: 900px) 40vw, 78vw" />)}
        </SwipeRow>
        <div class="container strip__meta mono">
          <span class="strip__count">{strip.length + 1} of {photoCount} photos</span>
          <a href={flatHref}>View all</a>
        </div>
      </div>
    </section>

    <section class="section ways" aria-labelledby="ways-title">
      <div class="container">
        <h2 id="ways-title">Two ways to stay</h2>
        <div class="ways__grid">
          <div class="ways__col">
            <Label tone="on-forest">Up to {booking.maxInstantNights} nights · Book now</Label>
            <h3 class="h3">Short stays</h3>
            <p>Weekends, family visits and breaks of up to {booking.maxInstantNights} nights, booked instantly.</p>
            <p class="mono ways__fact">From £{price} a night</p>
            <Button href={checkDates} variant="paper" data-open-dates>Check dates</Button>
          </div>
          <div class="ways__col">
            <Label tone="on-forest">{booking.maxInstantNights + 1} nights or more · Enquire</Label>
            <h3 class="h3">Work and long stays</h3>
            <p>
              The whole flat to one booker, for teams and placements of up to {booking.maxNights} nights. Send us your dates for a quote,
              with invoices in your company name.
            </p>
            <p class="mono ways__fact">Reply within a few hours</p>
            <Button href="/work-stays" variant="secondary">Ask for a quote</Button>
          </div>
        </div>
      </div>
    </section>

    <section class="section why" aria-labelledby="why-title">
      <div class="container">
        <h2 id="why-title" class="why__line">Same flat as on Airbnb, <em>without the platform fee.</em></h2>
        <ul class="why__points">
          <li>
            <h3>Lowest price is here</h3>
            <p>The nightly rate on this site is always below the price on the booking platforms.</p>
          </li>
          <li>
            <h3>No booking or cleaning fees</h3>
            <p>No service fee and no cleaning fee. The price you see first is the price you pay.</p>
          </li>
          <li>
            <h3>Two hosts, not a call centre</h3>
            <p>Questions go straight to <a href="/about">our team</a>. {site.responseTime}</p>
          </li>
        </ul>
        <p class="why__more"><a class="text-link" href="/book-direct">More on booking direct</a></p>
      </div>
    </section>

    <section class="section hood" aria-labelledby="hood-title">
      <div class="container hood__grid">
        <div class="hood__text">
          <Label>{flat.area}, {flat.postcodeArea.replace('London ', '')}</Label>
          <h2 id="hood-title">A minute from Church Street</h2>
          <p class="lead">{flat.overview[2]}</p>
          <Schedule variant="distance" ground="mist" rows={distances} />
          <p class="hood__more"><a class="text-link" href={`/areas/${flat.areaSlug}`}>Read our Stoke Newington guide</a></p>
        </div>
        <div class="hood__photos">
          <Photo slug={flat.slug} file={churchStreet.file} alt={churchStreet.alt} ratio="3/2" sizes="(min-width: 900px) 520px, 100vw" class="hood__wide" />
          <Photo slug={flat.slug} file={park.file} alt={park.alt} ratio="1" sizes="(min-width: 900px) 260px, 50vw" />
          <Photo slug={flat.slug} file={hosts.file} alt={hosts.alt} ratio="1" sizes="(min-width: 900px) 260px, 50vw" />
        </div>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <h2 id="faq-title">Before you book</h2>
        <div>
          <Accordion items={homeFaqs} />
          <p class="faq__more"><a class="text-link" href="/faq">All questions</a></p>
        </div>
      </div>
    </section>
  </div>

  <StickyBar price={price} href={checkDates} after="#hero" />
</Base>

<style>
  .home {
    background: var(--paper);
    color: var(--ink);
  }
  .home h2 {
    color: var(--forest);
  }
  .home .section + .section {
    padding-top: var(--section);
  }

  /* 1. Hero: headline on paper first on phones; over the frame edge from 900px */
  .hero {
    padding-top: calc(var(--header-h) + var(--s4));
    padding-bottom: var(--section);
  }
  .hero__title {
    margin: 0 0 var(--s3);
    font-size: var(--t-hero);
    line-height: 0.9;
    letter-spacing: -0.015em;
    color: var(--forest);
  }
  .hero__title span {
    display: block;
  }
  .hero__intro {
    margin: var(--s3) 0 var(--s3);
  }
  .hero :global(.hero__facts) {
    padding-top: var(--s2);
    border-top: 1px solid var(--line-strong);
  }
  .hero :global(.hero__cta) {
    display: none;
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: calc(var(--header-h) + var(--s6));
    }
    .hero__stage {
      position: relative;
    }
    .hero__title {
      position: absolute;
      top: var(--s5);
      left: 0;
      z-index: 1;
      margin: 0;
    }
    .hero :global(.hero__photo) {
      margin-left: 38%;
      height: 620px;
      aspect-ratio: auto !important;
    }
    .hero :global(.hero__photo img) {
      object-position: 50% 0;
    }
    .hero__row {
      display: grid;
      grid-template-columns: 1.1fr 1.2fr auto;
      gap: var(--s5);
      align-items: end;
      margin-top: var(--s5);
    }
    .hero__intro {
      margin: 0;
    }
    .hero :global(.hero__facts) {
      padding-top: 0;
      border-top: 0;
    }
    .hero :global(.hero__cta) {
      display: inline-flex;
    }
  }

  /* 2. The flat */
  .flat {
    border-top: 1px solid var(--line);
  }
  .flat__grid {
    display: grid;
    gap: var(--s4);
  }
  .flat h2 {
    font-size: clamp(2.375rem, 1.9rem + 1.9vw, 3.5rem);
  }
  .flat__more {
    margin: var(--s3) 0 0;
  }
  @media (min-width: 900px) {
    .flat__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--s8);
      align-items: start;
    }
  }

  /* Phone: swipe row with its counter and "View all" on one line. From 900px: the 2fr 1fr 1fr 1fr strip. */
  .strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    margin-top: var(--s6);
  }
  .strip :global(.swipe) {
    display: contents;
  }
  .strip :global(.swipe__track) {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .strip__meta {
    width: auto;
    margin: 12px 0 0;
  }
  .strip__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--forest);
  }
  .strip__count {
    display: none;
  }
  @media (min-width: 900px) {
    .strip :global(.swipe__track) {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      width: 100%;
      height: 300px;
      max-width: calc(var(--max) + var(--gutter) * 2);
      margin-inline: auto;
      overflow: visible;
    }
    .strip :global(.swipe__track .photo) {
      aspect-ratio: auto !important;
      height: 100%;
    }
    .strip :global(.swipe__count) {
      display: none;
    }
    .strip__meta {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      margin-inline: auto;
    }
    .strip__count {
      display: inline;
      color: var(--forest-soft);
    }
  }

  /* 3. Two ways to stay: forest ground */
  .ways {
    background: var(--forest);
    color: var(--on-forest-2);
  }
  .home .ways h2,
  .ways .h3 {
    color: var(--on-forest);
  }
  .ways h2 {
    margin-bottom: var(--s5);
  }
  .ways__grid {
    display: grid;
  }
  .ways__col {
    padding-block: var(--s4);
    border-top: 1px solid rgb(238 240 232 / 0.25);
  }
  .ways__col p:not(.label) {
    max-width: 30em;
  }
  .ways__fact {
    color: var(--on-forest);
    margin-bottom: var(--s3);
  }
  .ways :global(.button--secondary:hover) {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--forest);
  }
  @media (min-width: 900px) {
    .ways__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ways__col {
      padding: var(--s2) var(--s6) var(--s2) 0;
      border-top: 0;
    }
    .ways__col + .ways__col {
      padding: var(--s2) 0 var(--s2) var(--s6);
      border-left: 1px solid rgb(238 240 232 / 0.25);
    }
  }

  /* 4. Why book here: plain text, no boxes */
  .why__line {
    max-width: 16em;
    margin-bottom: var(--s6);
  }
  .why__points {
    display: grid;
    gap: var(--s3);
    margin: 0 0 var(--s4);
    padding: var(--s3) 0 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .why__points h3 {
    margin-bottom: var(--s1);
    font-size: var(--t-body);
    color: var(--ink);
  }
  .why__points p {
    margin: 0;
    max-width: 24em;
    color: var(--text-3);
  }
  .why__more {
    margin: 0;
  }
  @media (min-width: 900px) {
    .why__points {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s6);
    }
  }

  /* 5. Neighbourhood: mist ground */
  .hood {
    background: var(--mist);
  }
  .hood__grid {
    display: grid;
    gap: var(--s5);
  }
  .hood__more {
    margin: var(--s3) 0 0;
  }
  .hood__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    align-content: start;
  }
  .hood :global(.hood__wide) {
    grid-column: span 2;
  }
  @media (min-width: 900px) {
    .hood__grid {
      grid-template-columns: 6fr 5fr;
      gap: var(--s8);
    }
  }
  /* Live site before the area photos exist: no empty column */
  .hood__photos:not(:has(.photo)) {
    display: none;
  }

  /* 6. Before you book */
  .faq__grid {
    display: grid;
    gap: var(--s3);
  }
  .faq__more {
    margin: var(--s3) 0 0;
  }
  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: 4fr 7fr;
      gap: var(--s8);
    }
  }
</style>
