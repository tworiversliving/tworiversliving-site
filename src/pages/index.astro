---
import Base from '../layouts/Base.astro';
import PhotoCarousel from '../components/ui/PhotoCarousel.astro';
import FocusCarousel from '../components/FocusCarousel.astro';
import Label from '../components/ui/Label.astro';
import Button from '../components/ui/Button.astro';
import Schedule from '../components/ui/Schedule.astro';
import Accordion from '../components/ui/Accordion.astro';
import StickyBar from '../components/StickyBar.astro';
import { booking } from '../config/booking';
import { site } from '../config/site';
import { properties, ratingLine } from '../data/properties';
import { homeFaqs } from '../data/faq';
import { todo } from '../data/todo';

const flat = properties[0];
const flatHref = `/stays/${flat.slug}`;
// "Check dates" opens the date sheet; without JavaScript it goes to the booking card.
const checkDates = `${flatHref}#book`;
const price = flat.fromPriceFallback;

// Only photo files that exist, grouped by room in the order properties.ts lists them
const files = import.meta.glob('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}');
const existing = flat.photos.filter((ph) => ph.room !== 'Neighbourhood' && `/src/assets/properties/${flat.slug}/${ph.file}` in files);
const rooms = [...new Set(existing.map((ph) => ph.room))];
const bedPhoto = (room: string) => flat.sleeping.find((s) => s.room === room)?.photo;

// Hero carousel: one main photo per room, no TV shots above the fold (BRIEF.md 3). Opens on the living room.
const mainPhoto = (room: string) =>
  existing.find((ph) => ph.file === bedPhoto(room)) ?? existing.find((ph) => ph.room === room && !ph.tv && ph.file !== 'living-room.jpg');
// A room with one photo (the workspace) stays out of the hero, so the room cards below don't repeat it.
const heroPhotos = rooms
  .filter((room) => existing.filter((ph) => ph.room === room).length > 1)
  .map(mainPhoto)
  .filter((ph) => ph !== undefined);

// Room cards: each room's photos, starting on one the hero doesn't show, the hero's photo last
const facts: Record<string, string> = {
  'Living room': 'Sofas and a TV',
  'Kitchen and dining': 'Full kitchen, dining table for everyone',
  Bathroom: ['One bathroom', todo.showerOrBath.toLowerCase()].filter(Boolean).join(', '),
  Workspace: ['Desk and chair', todo.wifiSpeed && `wifi tested at ${todo.wifiSpeed}`].filter(Boolean).join(', '),
  ...Object.fromEntries(flat.sleeping.map((s) => [s.room, s.bed])),
};
const roomCards = rooms.map((room) => {
  const all = existing.filter((ph) => ph.room === room);
  const lead = mainPhoto(room);
  return { room, detail: facts[room] ?? '', photos: [...all.filter((ph) => ph !== lead), ...all.filter((ph) => ph === lead)] };
});

// The two facts that aren't a room with photos
const flatRows = [
  { key: 'Laundry', value: 'Washing machine' },
  { key: 'Access', value: 'Top floor, stairs to the front door, no lift' },
];

// Share card from scripts/og-card.mjs (BRIEF.md 4.5)
const ogCard = { src: '/og/stoke-newington.png', alt: `Stoke Newington, kept local. ${flat.guests} guests, ${flat.bedrooms} bedrooms, with the dining table.` };
---

<Base
  title={site.name}
  description="Book a three-bedroom flat in Stoke Newington direct with the hosts. No booking or cleaning fees, for short breaks and work trips."
  ogCard={ogCard}
>
  <div class="home" data-home-slug={flat.slug}>
    <section class="hero" id="hero">
      <div class="container">
        <div class="hero__stage">
          <h1 class="hero__title">
            <span>Stoke Newington,</span>
            <span class="worn">kept local.</span>
          </h1>
          <PhotoCarousel
            slug={flat.slug}
            photos={heroPhotos}
            label="Photos of the flat, one from each room"
            ratio="4/5"
            sizes="(min-width: 1440px) 820px, (min-width: 900px) 62vw, 100vw"
            eager
            rounded
            class="hero__photo"
          />
        </div>

        <div class="hero__row">
          <p class="lead hero__intro">A three-bedroom flat a minute from Church Street, for short breaks and work trips.</p>
          <Schedule
            variant="inline"
            class="hero__facts"
            rows={[
              { key: 'Sleeps', value: `${flat.guests} · three doubles + sofa bed` },
              { key: 'Church St', value: '1 min walk' },
              { key: 'Liverpool St', value: '15 min by train' },
              { key: 'Fees', value: 'none, the price is the price' },
              { key: 'Rated', value: ratingLine(flat) },
            ]}
          />
          <Button href={checkDates} variant="price" sub={`from £${price} a night`} class="hero__cta" data-open-dates>Check dates</Button>
        </div>
      </div>
    </section>

    <section class="section flat" aria-labelledby="flat-title">
      <div class="container flat__head">
        <div>
          <Label>The flat</Label>
          <h2 id="flat-title">Three doubles, one long table and a <em>real</em> desk.</h2>
        </div>
        <p class="lead">{flat.overview[0]}</p>
      </div>
    </section>

    <FocusCarousel slug={flat.slug} rooms={roomCards} />

    <div class="flat-foot">
      <div class="container flat__foot">
        <Schedule variant="inline" rows={flatRows} />
        <a class="text-link" href={flatHref}>See the whole flat</a>
      </div>
    </div>

    <section class="section ways" aria-labelledby="ways-title">
      <div class="container">
        <h2 id="ways-title">Two ways to stay</h2>
        <div class="ways__grid">
          <div class="ways__col">
            <Label tone="on-forest">Up to {booking.maxInstantNights} nights · Book now</Label>
            <h3 class="h3">Short stays</h3>
            <p>Weekends, family visits and breaks of up to {booking.maxInstantNights} nights, booked instantly.</p>
            <p class="mono ways__fact" data-from-line>From £{price} a night</p>
            <Button href={checkDates} variant="paper" data-open-dates>Check dates</Button>
          </div>
          <div class="ways__col">
            <Label tone="on-forest">{booking.maxInstantNights + 1} nights or more · Enquire</Label>
            <h3 class="h3">Work and long stays</h3>
            <p>
              The whole flat to one booker, for teams and placements of up to {booking.maxNights} nights. Send us your dates for a quote,
              with invoices in your company name.
            </p>
            <p class="mono ways__fact">Reply within a few hours</p>
            <Button href="/work-stays" variant="secondary">Ask for a quote</Button>
          </div>
        </div>
      </div>
    </section>

    <section class="section why" aria-labelledby="why-title">
      <div class="container">
        <h2 id="why-title" class="why__line">Same flat as on Airbnb, <em>booked straight with us.</em></h2>
        <ul class="why__points">
          <li>
            <h3>No platform in between</h3>
            <p>Your booking comes straight to us, so dates, changes and questions are sorted faster.</p>
          </li>
          <li>
            <h3>No booking or cleaning fees</h3>
            <p>No service fee and no cleaning fee. The price you see first is the price you pay.</p>
          </li>
          <li>
            <h3>Two hosts, not a call centre</h3>
            <p>Questions go straight to <a href="/about">our team</a>. {site.responseTime}</p>
          </li>
        </ul>
        <p class="why__more"><a class="text-link" href="/book-direct">More on booking direct</a></p>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <h2 id="faq-title">Before you book</h2>
        <div>
          <Accordion items={homeFaqs} />
          <p class="faq__more"><a class="text-link" href="/faq">All questions</a></p>
        </div>
      </div>
    </section>
  </div>

  <StickyBar price={price} href={checkDates} after="#hero" />
</Base>

<script>
  // The "from" prices above are properties.ts's fallback until the live rate loads: the same rule as the
  // property page's booking card (lowest direct rate in the next 60 days), from the same endpoint.
  import { addDays, loadAvailability } from '../scripts/dates';
  import { gbp } from '../scripts/booking';

  const slug = document.querySelector<HTMLElement>('[data-home-slug]')?.dataset.homeSlug;
  if (slug)
    loadAvailability(slug).then((av) => {
      if (!av) return;
      const soon = [...av.days.values()].filter((d) => d.available && d.price != null && d.date < addDays(av.today, 60)).map((d) => d.price!);
      if (!soon.length) return;
      const from = gbp(Math.min(...soon));
      document.querySelectorAll('[data-from-price]').forEach((el) => (el.textContent = from));
      document.querySelectorAll('[data-from-line]').forEach((el) => (el.textContent = el.textContent!.replace(/£[\d,]+(\.\d\d)?/, from)));
    });
</script>

<style>
  .home {
    background: var(--paper);
    color: var(--ink);
  }
  .home h2 {
    color: var(--forest);
  }
  .home .section + .section {
    padding-top: var(--section);
  }

  /* 1. Hero: headline on paper first on phones; over the frame edge from 900px */
  .hero {
    padding-top: calc(var(--header-h) + var(--s4));
    padding-bottom: var(--section);
  }
  .hero__title {
    margin: 0 0 var(--s3);
    font-size: var(--t-hero);
    line-height: 0.9;
    letter-spacing: -0.015em;
    color: var(--forest);
  }
  .hero__title span {
    display: block;
  }
  .hero__intro {
    margin: var(--s3) 0 var(--s3);
  }
  .hero :global(.hero__facts) {
    padding-top: var(--s2);
    border-top: 1px solid var(--line-strong);
  }
  .hero :global(.hero__cta) {
    display: none;
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: calc(var(--header-h) + var(--s6));
    }
    .hero__stage {
      position: relative;
    }
    .hero__title {
      position: absolute;
      top: var(--s5);
      left: 0;
      z-index: 1;
      margin: 0;
    }
    /* The carousel sits right of the headline; the headline lets taps and swipes through to it */
    .hero__title {
      pointer-events: none;
    }
    .hero :global(.hero__photo) {
      margin-left: 38%;
    }
    .hero :global(.hero__photo .photo) {
      height: 620px;
      aspect-ratio: auto !important;
    }
    .hero :global(.hero__photo img) {
      object-position: 50% 30%;
    }
    .hero__row {
      display: grid;
      grid-template-columns: 1.1fr 1.2fr auto;
      gap: var(--s5);
      align-items: end;
      margin-top: var(--s5);
    }
    .hero__intro {
      margin: 0;
    }
    .hero :global(.hero__facts) {
      padding-top: 0;
      border-top: 0;
    }
    .hero :global(.hero__cta) {
      display: inline-flex;
    }
  }

  /* 2. The flat: heading and intro on paper, the rooms on forest (FocusCarousel), then the two facts on paper */
  .flat {
    border-top: 1px solid var(--line);
  }
  .flat h2 {
    font-size: clamp(2.375rem, 1.9rem + 1.9vw, 3.5rem);
    margin: 0;
  }
  .flat__head {
    display: grid;
    gap: var(--s3);
  }
  .flat__head .lead {
    margin: 0;
  }
  .flat-foot {
    padding-block: var(--s5);
  }
  .flat__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
  }
  @media (min-width: 900px) {
    .flat__head {
      grid-template-columns: 6fr 5fr;
      gap: var(--s8);
      align-items: end;
    }
  }

  /* 3. Two ways to stay: forest ground */
  .ways {
    background: var(--forest);
    color: var(--on-forest-2);
  }
  .home .ways h2,
  .ways .h3 {
    color: var(--on-forest);
  }
  .ways h2 {
    margin-bottom: var(--s5);
  }
  .ways__grid {
    display: grid;
  }
  .ways__col {
    padding-block: var(--s4);
    border-top: 1px solid rgb(238 240 232 / 0.25);
  }
  .ways__col p:not(.label) {
    max-width: 30em;
  }
  .ways__fact {
    color: var(--on-forest);
    margin-bottom: var(--s3);
  }
  .ways :global(.button--secondary:hover) {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--forest);
  }
  @media (min-width: 900px) {
    .ways__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ways__col {
      padding: var(--s2) var(--s6) var(--s2) 0;
      border-top: 0;
    }
    .ways__col + .ways__col {
      padding: var(--s2) 0 var(--s2) var(--s6);
      border-left: 1px solid rgb(238 240 232 / 0.25);
    }
  }

  /* 4. Why book here: plain text, no boxes */
  .why__line {
    max-width: 16em;
    margin-bottom: var(--s6);
  }
  .why__points {
    display: grid;
    gap: var(--s3);
    margin: 0 0 var(--s4);
    padding: var(--s3) 0 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .why__points h3 {
    margin-bottom: var(--s1);
    font-size: var(--t-body);
    color: var(--ink);
  }
  .why__points p {
    margin: 0;
    max-width: 24em;
    color: var(--text-3);
  }
  .why__more {
    margin: 0;
  }
  @media (min-width: 900px) {
    .why__points {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s6);
    }
  }

  /* 5. Before you book: paper after paper, so a rule between them */
  .faq {
    border-top: 1px solid var(--line);
  }
  .faq__grid {
    display: grid;
    gap: var(--s3);
  }
  .faq__more {
    margin: var(--s3) 0 0;
  }
  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: 4fr 7fr;
      gap: var(--s8);
    }
  }
</style>
