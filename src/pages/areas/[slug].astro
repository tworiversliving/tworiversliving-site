---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/ui/Photo.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import Text from '../../components/Text.astro';
import { areas, type Area } from '../../data/areas';
import { properties } from '../../data/properties';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const homes = properties.filter((p) => p.areaSlug === area.slug);
const source = properties.find((p) => p.slug === area.propertySlug);
const walking = source?.walkingTimes ?? [];
const areaPhoto = area.sections.flatMap((s) => s.photos ?? [])[0];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
// One photo per room for each flat's card, starting with its card photo. No neighbourhood or TV shots.
const cardPhotos = (p: (typeof homes)[number]) => {
  const pool = p.photos.filter((ph) => ph.room !== 'Neighbourhood' && !ph.tv);
  const first = pool.find((ph) => ph.file === p.cardPhoto) ?? pool[0];
  const rest = [...new Set(pool.map((ph) => ph.room))].filter((r) => r !== first.room).map((r) => pool.find((ph) => ph.room === r)!);
  return [first, ...rest];
};
---

<Base
  title={`${area.name} guide`}
  description={area.description}
  ogPhoto={areaPhoto ? { slug: area.propertySlug, file: areaPhoto } : undefined}
>
  <div class="container narrow page-head">
    <span class="kicker">Area guide</span>
    <h1>{area.name}</h1>
    {area.intro.map((para) => <p>{para}</p>)}
  </div>

  <div class="container narrow">
    {
      walking.length > 0 && (
        <dl class="times">
          {walking.map((w) => (
            <div>
              <dt>{w.place}</dt>
              <dd>{w.time}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      area.sections.map((s) => (
        <section class="part">
          <h2>{s.title}</h2>
          <p>
            <Text text={s.intro} />
          </p>
          {s.items.length > 0 && (
            <ul class="places">
              {s.items.map((i) => (
                <li>
                  <strong>{i.name}</strong>
                  <span class="muted">
                    <Text text={i.note} />
                  </span>
                </li>
              ))}
            </ul>
          )}
          {source &&
            s.photos?.map((file) => {
              const ph = source.photos.find((x) => x.file === file);
              return <Photo slug={source.slug} file={file} alt={ph?.alt ?? ''} sizes="(min-width: 800px) 760px, 100vw" />;
            })}
        </section>
      ))
    }
  </div>

  {
    homes.length > 0 && (
      <section class="section">
        <div class="container">
          <h2>Stay in {area.name}</h2>
          <div class="homes">
            {homes.map((p) => (
              <PhotoCard
                slug={p.slug}
                label={p.area}
                title={p.name}
                meta={`${plural(p.guests, 'guest')} · ${plural(p.bedrooms, 'bedroom')} · ${plural(p.bathrooms, 'bathroom')}`}
                photos={cardPhotos(p)}
                note={`From £${p.fromPriceFallback} a night`}
                href={`/stays/${p.slug}`}
                sizes="(min-width: 640px) 400px, 100vw"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .times {
    margin: 0 0 var(--s4);
  }
  .times div {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s1) 0;
    border-bottom: 1px solid var(--line);
  }
  .times dd {
    margin: 0;
    color: var(--forest-soft);
  }
  .part {
    padding-block: var(--s5);
    border-top: 1px solid var(--line);
  }
  .part h2 {
    font-size: var(--text-xl);
  }
  .places {
    margin: 0 0 var(--s3);
    padding: 0;
    list-style: none;
  }
  .places li {
    display: grid;
    padding-block: var(--s1);
  }
  /* Cards about 300 to 400px wide, as many as fit. The container lets the card's photos swipe once it is wide. */
  .homes {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 400px));
    gap: var(--s2);
  }
</style>
