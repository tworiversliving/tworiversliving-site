---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/ui/Photo.astro';
import Button from '../../components/ui/Button.astro';
import Schedule from '../../components/ui/Schedule.astro';
import Text from '../../components/Text.astro';
import { areas, type Area } from '../../data/areas';
import { properties } from '../../data/properties';
import { todo } from '../../data/todo';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const homes = properties.filter((p) => p.areaSlug === area.slug);
const source = properties.find((p) => p.slug === area.propertySlug);
// Bus routes are still a TODO: the row hides until it is filled in.
const distances = [...(source?.walkingTimes ?? []).map((w) => ({ key: w.place, value: w.time })), { key: 'Buses', value: todo.busRoutes }];
// A section with nothing to say yet stays off the page
const sections = area.sections.filter((s) => s.intro.trim() || s.items.length);
const areaPhoto = sections.flatMap((s) => s.photos ?? [])[0];
const alt = (file: string) => source?.photos.find((x) => x.file === file)?.alt ?? '';
---

<Base title={`${area.name} guide`} description={area.description} ogPhoto={areaPhoto ? { slug: area.propertySlug, file: areaPhoto } : undefined}>
  <div class="container page-head guide-head">
    <div>
      <p class="label">Area guide</p>
      <h1>{area.name}</h1>
      {area.intro.map((para) => <p>{para}</p>)}
    </div>
    {distances.length > 1 && <Schedule variant="distance" rows={distances} class="guide-head__times" />}
  </div>

  {
    sections.map((s, i) => (
      <section class="section section--ruled part" aria-labelledby={`part-${i}`}>
        <div class:list={['container', 'part__grid', { 'part__grid--flip': i % 2 === 1 }]}>
          <div class="part__text">
            <h2 id={`part-${i}`}>{s.title}</h2>
            {s.intro && (
              <p class="lead">
                <Text text={s.intro} />
              </p>
            )}
            {s.items.length > 0 && (
              <ul class="places">
                {s.items.map((item) => (
                  <li>
                    <span class="places__name">{item.name}</span>
                    {item.note && (
                      <span class="places__note">
                        <Text text={item.note} />
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
          {source && s.photos?.[0] && (
            <Photo slug={source.slug} file={s.photos[0]} alt={alt(s.photos[0])} ratio="3/2" sizes="(min-width: 900px) 620px, 100vw" />
          )}
        </div>
      </section>
    ))
  }

  {
    homes.map((p) => (
      <section class="section section--mist stay" aria-labelledby="stay-title">
        <div class="container split">
          <h2 id="stay-title">Stay a minute from Church Street</h2>
          <div>
            <p class="lead">{p.summary}</p>
            <Schedule
              ground="mist"
              rows={[
                { key: 'Sleeps', value: `${p.guests}, ${p.beds}` },
                { key: 'From', value: `£${p.fromPriceFallback} a night, no fees` },
              ]}
            />
            <p class="stay__actions">
              <Button href={`/stays/${p.slug}#book`} data-open-dates>
                Check dates
              </Button>
              <Button href={`/stays/${p.slug}`} variant="secondary">
                See the flat
              </Button>
            </p>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .guide-head {
    display: grid;
    gap: var(--s5);
  }
  @media (min-width: 900px) {
    .guide-head {
      grid-template-columns: 6fr 5fr;
      gap: var(--s8);
      align-items: end;
    }
  }

  .part__grid {
    display: grid;
    gap: var(--s4);
  }
  .part h2 {
    font-size: var(--t-h3);
    line-height: 1.1;
  }
  @media (min-width: 900px) {
    .part__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--s8);
      align-items: start;
    }
    .part__grid--flip .part__text {
      order: 1;
    }
    .part h2 {
      font-size: var(--t-h2);
      line-height: 1;
    }
  }

  .places {
    margin: var(--s3) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .places li {
    display: grid;
    gap: 2px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .places__name {
    font-weight: 500;
  }
  .places__note {
    color: var(--text-3);
  }

  .stay h2 {
    font-size: var(--t-h2);
  }
  .stay__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: var(--s4) 0 0;
  }
</style>
