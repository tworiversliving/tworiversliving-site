---
// With one property there is no listing to show: /stays sends guests to the flat, keeping any
// dates and guests in the query string. Runs in the Worker so it is a real redirect, not a page.
// Temporary (302) so a listing can come back here when there is a second property.
import { properties } from '../../data/properties';

export const prerender = false;

const target = new URL(`/stays/${properties[0].slug}`, Astro.url);
target.search = Astro.url.search;
return Astro.redirect(`${target.pathname}${target.search}`, 302);
---
