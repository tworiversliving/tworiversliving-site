---
import Base from '../../layouts/Base.astro';
import BookingPanel from '../../components/BookingPanel.astro';
import Photo from '../../components/ui/Photo.astro';
import Reviews from '../../components/Reviews.astro';
import Text from '../../components/Text.astro';
import AreaMap from '../../components/AreaMap.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import PhotoCarousel from '../../components/ui/PhotoCarousel.astro';
import { booking } from '../../config/booking';
import { properties, ratingLine, type Property } from '../../data/properties';
import { schemaImages } from '../../lib/og';
import { lodging } from '../../lib/schema';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

interface Props {
  property: Property;
}

const { property: p } = Astro.props;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const specs = `${plural(p.guests, 'guest')} · ${plural(p.bedrooms, 'bedroom')} · ${plural(p.bathrooms, 'bathroom')}`;

const rooms = [...new Set(p.photos.map((ph) => ph.room))];
// Gallery photos: files that exist, no neighbourhood shots. A TV shot is never first.
const files = import.meta.glob('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}');
const pool = p.photos.filter((ph) => ph.room !== 'Neighbourhood' && `/src/assets/properties/${p.slug}/${ph.file}` in files);
const hero = pool.find((ph) => ph.file === p.heroPhoto && !ph.tv) ?? pool.find((ph) => !ph.tv) ?? p.photos[0];
// One photo per room after the hero, so the desktop grid shows the whole flat rather than one room five times.
const gallery = [hero, ...rooms.filter((r) => r !== hero.room).map((r) => pool.find((ph) => ph.room === r && !ph.tv)).filter((ph) => ph !== undefined)].slice(0, 5);
// The phone carousel carries on through every other photo, TV shots last.
const others = pool.filter((ph) => !gallery.includes(ph));
const carousel = [...gallery, ...others.filter((ph) => !ph.tv), ...others.filter((ph) => ph.tv)];
const photoFor = (file?: string) => p.photos.find((ph) => ph.file === file);
const roomId = (room: string) => `photos-${room.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
// Each bedroom's own photos, with its main photo first
const roomPhotos = (room: string, main?: string) => {
  const all = p.photos.filter((ph) => ph.room === room);
  return [...all.filter((ph) => ph.file === main), ...all.filter((ph) => ph.file !== main)];
};
const schema = [lodging(p, await schemaImages(p.slug, gallery.map((ph) => ph.file)))];
---

<Base
  title={p.name}
  description={`${p.summary} Sleeps ${p.guests}. Book direct with the hosts, with no booking fees.`}
  ogPhoto={{ slug: p.slug, file: p.ogPhoto }}
  schema={schema}
  crumbs={[
    { name: 'Stays', path: '/stays' },
    { name: p.name, path: `/stays/${p.slug}` },
  ]}
>
  <div class="container top">
    <PhotoCarousel
      slug={p.slug}
      photos={carousel}
      label={`Photos of the ${p.name.toLowerCase()}`}
      ratio="4/3"
      sizes="(min-width: 960px) 640px, 100vw"
      eager
      rounded
      class="gallery"
    >
      <button type="button" class="button gallery__all" data-open-photos>View all photos</button>
    </PhotoCarousel>
  </div>

  <div class="container layout">
    <div class="content">
      <header class="title">
        <span class="kicker">{p.area}</span>
        <h1>{p.name}</h1>
        <p class="muted">
          {specs} · {p.beds}
          {p.reviews.length > 0 && <> · <a href="#reviews">{plural(p.reviews.length, 'review')}</a></>}
        </p>
        {p.ratings.length > 0 && <p class="mono rated">Rated {ratingLine(p)}</p>}
      </header>

      <section class="block">
        {p.overview.map((para) => <p>{para}</p>)}
      </section>

      <section class="block sleep" aria-labelledby="sleep">
        <h2 id="sleep">Where you'll sleep</h2>
        <div class="rooms">
          {p.sleeping.map((r) => <PhotoCard slug={p.slug} title={r.room} meta={r.bed} photos={roomPhotos(r.room, r.photo)} viewerId={roomId(r.room)} />)}
        </div>
      </section>

      <section class="block" aria-labelledby="amenities">
        <h2 id="amenities">What's in the flat</h2>
        <ul class="ticks cols">
          {p.amenities.top.map((a) => <li>{a}</li>)}
        </ul>
        <details class="all">
          <summary class="text-link">Show all amenities</summary>
          <div class="all__groups">
            {
              Object.entries(p.amenities.all).map(([group, items]) => (
                <div>
                  <h3>{group}</h3>
                  <ul class="ticks">
                    {items.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </details>
      </section>

      <section class="block" aria-labelledby="working">
        <h2 id="working">Working here</h2>
        <ul class="ticks">
          {p.working.map((w) => <li><Text text={w} /></li>)}
        </ul>
        <p><a class="text-link" href="/work-stays">Work and long stays</a></p>
      </section>

      <section class="block" aria-labelledby="location">
        <h2 id="location">Location</h2>
        <p>
          {p.area}, {p.postcodeArea}. We send the exact address 48 hours before you arrive.
        </p>
        <AreaMap property={p} />
        <dl class="times">
          {
            p.walkingTimes.map((w) => (
              <div>
                <dt>{w.place}</dt>
                <dd>{w.time}</dd>
              </div>
            ))
          }
        </dl>
        <p><a class="text-link" href={`/areas/${p.areaSlug}`}>Our {p.area} guide</a></p>
      </section>

      <section class="block" aria-labelledby="rules">
        <h2 id="rules">Check-in and house rules</h2>
        <p>Self check-in with a key lockbox. We send the details 48 hours before you arrive.</p>
        <ul class="ticks">
          {p.houseRules.map((r) => <li>{r}</li>)}
        </ul>
        <p><a href="/house-rules">Full house rules</a></p>
      </section>

      <section class="block" aria-labelledby="know">
        <h2 id="know">Good to know</h2>
        <ul class="ticks">
          {p.goodToKnow.map((g) => <li>{g}</li>)}
        </ul>
      </section>

      <section class="block" aria-labelledby="cancel">
        <h2 id="cancel">Cancellation</h2>
        <p>
          Full refund if you cancel more than {booking.freeCancellationDays} days before check-in. <a href="/terms">Booking terms</a>
        </p>
      </section>

      {
        p.reviews.length > 0 && (
          <section class="block" id="reviews" aria-labelledby="reviews-title">
            <h2 id="reviews-title">Reviews</h2>
            <Reviews reviews={p.reviews} />
          </section>
        )
      }
    </div>

    <BookingPanel property={p} />
  </div>

  <div class="mobile-bar">
    <p>From <strong data-from-price>£{p.fromPriceFallback}</strong> a night</p>
    <a class="button" href="#book" data-open-dates>Check dates</a>
  </div>

  <dialog class="viewer" data-photos aria-label="All photos">
    <div class="viewer__head container">
      <p class="display">{p.name}</p>
      <button type="button" class="button button--ghost" data-close-photos>Close</button>
    </div>
    <div class="container">
      {
        rooms.map((room) => (
          <section class="viewer__room" id={roomId(room)}>
            <h2>{room}</h2>
            <div class="viewer__grid">
              {p.photos
                .filter((ph) => ph.room === room)
                .map((ph) => (
                  <Photo slug={p.slug} file={ph.file} alt={ph.alt} sizes="(min-width: 960px) 600px, 100vw" />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </dialog>
</Base>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('[data-photos]');
  // A room card's button opens the viewer at that room
  document.querySelectorAll<HTMLElement>('[data-open-photos]').forEach((btn) =>
    btn.addEventListener('click', () => {
      viewer?.showModal();
      const room = btn.dataset.openPhotos && document.getElementById(btn.dataset.openPhotos);
      room ? room.scrollIntoView({ block: 'start' }) : viewer?.scrollTo(0, 0);
    }),
  );
  document.querySelector('[data-close-photos]')?.addEventListener('click', () => viewer?.close());
</script>

<style>
  .top {
    padding-top: calc(var(--header-h) + var(--s3));
  }

  /* Phones and tablets: the rounded carousel through every photo. From 960px the same track becomes
     the 2fr 1fr 1fr grid of the first five (the photos are 1086px wide, too small to fill the page alone). */
  .gallery__all {
    position: absolute;
    right: 12px;
    bottom: 12px;
    min-height: 40px;
    padding-block: 8px;
    border-color: var(--paper);
    background: var(--paper);
    color: var(--forest);
  }
  .gallery__all:hover {
    border-color: var(--mist);
    background: var(--mist);
    color: var(--ink);
  }
  @media (min-width: 960px) {
    .top :global(.gallery .carousel__track) {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 10px;
      height: 580px;
      overflow: visible;
    }
    .top :global(.gallery .carousel__track > *) {
      aspect-ratio: auto !important;
      height: 100%;
      min-height: 0;
    }
    .top :global(.gallery .carousel__track > :first-child) {
      grid-row: span 2;
    }
    .top :global(.gallery .carousel__track > :nth-child(n + 6)),
    .top :global(.gallery .carousel__nav),
    .top :global(.gallery .carousel__count),
    .top :global(.gallery .carousel__dots) {
      display: none;
    }
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s6);
    padding-block: var(--s5) var(--section);
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: var(--s8);
    }
  }

  .rated {
    margin: 0;
    color: var(--forest-soft);
  }

  .title h1 {
    font-size: var(--text-2xl);
  }

  .block {
    padding-block: var(--s5);
    border-top: 1px solid var(--line);
  }
  .block h2 {
    font-size: var(--text-xl);
  }
  .title + .block {
    border-top: 0;
  }

  /* A swipe row of cards running to the screen edge, the next one peeking. Three columns once the content column
     is 720px wide, so a narrow desktop never leaves one card on a row of its own. */
  .sleep {
    container-type: inline-size;
  }
  .rooms {
    display: flex;
    gap: 12px;
    margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
    scrollbar-width: none;
  }
  .rooms::-webkit-scrollbar {
    display: none;
  }
  .rooms > :global(*) {
    flex: 0 0 min(84%, 300px);
    scroll-snap-align: start;
  }
  @container (min-width: 720px) {
    .rooms {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s2);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  @media (min-width: 640px) {
    .cols {
      columns: 2;
      column-gap: var(--s4);
    }
    .cols li {
      break-inside: avoid;
    }
  }

  .all summary {
    cursor: pointer;
    text-decoration: underline;
  }
  .all__groups {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s3);
  }
  @media (min-width: 640px) {
    .all__groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .all h3 {
    font-size: 1rem;
    margin-bottom: var(--s1);
  }

  .times {
    margin: 0 0 var(--s2);
  }
  .times div {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s1) 0;
    border-bottom: 1px solid var(--line);
  }
  .times dd {
    margin: 0;
    color: var(--forest-soft);
  }

  .mobile-bar {
    position: sticky;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s1) var(--gutter);
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .mobile-bar p {
    margin: 0;
  }
  @media (min-width: 960px) {
    .mobile-bar {
      display: none;
    }
  }

  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 0 var(--s8);
    border: 0;
    background: var(--mist);
    color: var(--forest);
  }
  .viewer::backdrop {
    background: var(--mist);
  }
  .viewer__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--s2);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }
  .viewer__head p {
    margin: 0;
    font-size: var(--text-lg);
  }
  .viewer__room {
    padding-top: var(--s5);
  }
  .viewer__room h2 {
    font-size: var(--text-xl);
  }
  .viewer__grid {
    display: grid;
    gap: var(--s2);
  }
  @media (min-width: 768px) {
    .viewer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
