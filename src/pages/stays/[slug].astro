---
import Base from '../../layouts/Base.astro';
import BookingPanel from '../../components/BookingPanel.astro';
import Photo from '../../components/ui/Photo.astro';
import Label from '../../components/ui/Label.astro';
import Schedule from '../../components/ui/Schedule.astro';
import Reviews from '../../components/Reviews.astro';
import AreaMap from '../../components/AreaMap.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import PhotoCarousel from '../../components/ui/PhotoCarousel.astro';
import StickyBar from '../../components/StickyBar.astro';
import { booking, extras } from '../../config/booking';
import { site } from '../../config/site';
import { properties, ratingLine, type Property } from '../../data/properties';
import { todo } from '../../data/todo';
import { schemaImages } from '../../lib/og';
import { lodging } from '../../lib/schema';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

interface Props {
  property: Property;
}

const { property: p } = Astro.props;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const facts = [plural(p.guests, 'guest'), plural(p.bedrooms, 'bedroom'), plural(p.bathrooms, 'bathroom'), p.floor];
const postcode = p.postcodeArea.replace('London ', '');

// Only photos whose files exist: a missing one would be a blank block in the gallery and the lightbox.
const files = import.meta.glob('/src/assets/properties/**/*.{jpg,jpeg,png,webp,avif}');
const existing = p.photos.filter((ph) => `/src/assets/properties/${p.slug}/${ph.file}` in files);
const rooms = [...new Set(existing.map((ph) => ph.room))];
// Gallery photos: no neighbourhood shots. A TV shot is never first.
const pool = existing.filter((ph) => ph.room !== 'Neighbourhood');
const hero = pool.find((ph) => ph.file === p.heroPhoto && !ph.tv) ?? pool.find((ph) => !ph.tv) ?? pool[0];
// One photo per room after the hero, so the desktop grid shows the whole flat rather than one room five times.
const gallery = [hero, ...rooms.filter((r) => r !== hero.room).map((r) => pool.find((ph) => ph.room === r && !ph.tv)).filter((ph) => ph !== undefined)].slice(0, 5);
// The phone carousel carries on through every other photo, TV shots last.
const others = pool.filter((ph) => !gallery.includes(ph));
const carousel = [...gallery, ...others.filter((ph) => !ph.tv), ...others.filter((ph) => ph.tv)];
const roomId = (room: string) => `photos-${room.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
// Each bedroom's own photos, with its main photo first
const roomPhotos = (room: string, main?: string) => {
  const all = existing.filter((ph) => ph.room === room);
  return [...all.filter((ph) => ph.file === main), ...all.filter((ph) => ph.file !== main)];
};
const schema = [lodging(p, await schemaImages(p.slug, gallery.map((ph) => ph.file)))];

// '15:00' -> '3pm', '12:30' -> '12:30pm'
const clock = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return `${h % 12 || 12}${m ? `:${String(m).padStart(2, '0')}` : ''}${h < 12 ? 'am' : 'pm'}`;
};
const pounds = (pence: number) => `£${pence / 100}`;
const extra = (id: string) => extras.find((e) => e.id === id && p.extras.includes(e.id));
const parking = extra('parking');
const early = extra('early_checkin');
const late = extra('late_checkout');
const extrasLine = [
  early && `${early.label.replace(/\d\d:\d\d/, clock).toLowerCase()} (${pounds(early.price)})`,
  late && `${late.label.replace(/\d\d:\d\d/, clock).toLowerCase()} (${pounds(late.price)})`,
  parking && `a parking permit (${pounds(parking.price)}${todo.parkingBasis ? ` ${todo.parkingBasis}` : ''})`,
].filter(Boolean);
const listJoin = (items: unknown[]) => (items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items.at(-1)}` : String(items[0] ?? ''));

const flatRows = [
  { key: 'Wifi', value: todo.wifiSpeed ? `Throughout the flat, tested at ${todo.wifiSpeed}` : 'Throughout the flat' },
  { key: 'Work', value: 'A desk and chair, away from the living room' },
  { key: 'Kitchen', value: 'Oven and hob, fridge-freezer, microwave, kettle and toaster' },
  { key: 'Dining', value: 'A table that seats everyone' },
  { key: 'Laundry', value: 'Washing machine' },
  { key: 'Living', value: 'Sofas and a TV' },
  { key: 'Bedding', value: 'Bed linen and towels provided' },
  { key: 'Parking', value: parking ? `Visitor permit for nearby resident bays, ${pounds(parking.price)}${todo.parkingBasis ? ` ${todo.parkingBasis}` : ''}` : '' },
  { key: 'Bathroom', value: [p.bathrooms === 1 ? 'One bathroom' : plural(p.bathrooms, 'bathroom'), todo.showerOrBath.toLowerCase()].filter(Boolean).join(', ') },
  { key: 'Hosts', value: `${site.hosts}, a few minutes away`, href: '/about' },
];

const distances = [...p.walkingTimes.map((w) => `${w.place} ${w.time}`), todo.busRoutes && `Buses ${todo.busRoutes}`].filter((d): d is string => Boolean(d));
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${p.area}, ${p.postcodeArea}`)}`;
// Mono lines break between items, never inside one
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const dotted = (items: string[]) => items.map((t) => `<span class="nowrap">${esc(t)}</span>`).join(' · ');
const rulesText = p.houseRules.map((r) => (/[.!?]$/.test(r) ? r : `${r}.`)).join(' ');
---

<Base
  title={p.name}
  description={`${p.summary} Sleeps ${p.guests}. Book direct with the hosts, with no booking fees.`}
  ogPhoto={{ slug: p.slug, file: p.ogPhoto }}
  schema={schema}
  crumbs={[
    { name: 'Stays', path: '/stays' },
    { name: p.name, path: `/stays/${p.slug}` },
  ]}
>
  <div class="stay">
    <div class="container top">
      <PhotoCarousel
        slug={p.slug}
        photos={carousel}
        label={`Photos of the ${p.name.toLowerCase()}`}
        ratio="4/5"
        sizes="(min-width: 900px) 640px, 100vw"
        eager
        class="gallery"
      >
        <a href="/" class="gallery__back" aria-label="Back" data-back>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5L7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </a>
        <button type="button" class="gallery__all" data-open-photos>All {existing.length} photos</button>
      </PhotoCarousel>
    </div>

    <div class="container layout">
      <div class="content">
        <header class="title">
          <Label>{p.street} · {postcode}</Label>
          <h1>
            {p.headline.map((line, i) => (
              <span class:list={['title__line', { worn: i === 1 }]}>
                {/* Never break inside "three-bedroom" */}
                {line.split(' ').map((w, j) => <>{j > 0 && ' '}{w.includes('-') ? <span class="nowrap">{w}</span> : w}</>)}
              </span>
            ))}
          </h1>
          <p class="title__facts"><Fragment set:html={dotted(facts)} /></p>
          {
            p.ratings.length > 0 && (
              <p class="title__rated">
                <Fragment set:html={dotted(ratingLine(p).split(' · ').map((r, i) => (i === 0 ? `Rated ${r}` : r)))} />
                {p.reviews.length > 0 && <> · <a href="#reviews">{plural(p.reviews.length, 'review')}</a></>}
              </p>
            )
          }
          <div class="title__intro">
            {p.overview.slice(0, 2).map((para) => <p>{para}</p>)}
          </div>
        </header>

        <section class="block sleep" aria-labelledby="sleep">
          <h2 id="sleep">Where you'll sleep</h2>
          <div class="rooms">
            {
              p.sleeping.map((r) => (
                <PhotoCard
                  slug={p.slug}
                  title={r.room}
                  meta={r.bed}
                  photos={roomPhotos(r.room, r.photo)}
                  viewerId={roomId(r.room)}
                  sizes="(min-width: 900px) 260px, 62vw"
                />
              ))
            }
          </div>
        </section>

        <section class="block" aria-labelledby="amenities">
          <h2 id="amenities">What's in the flat</h2>
          <Schedule rows={flatRows} columns={2} class="amenities" />
          <p class="block__more"><a class="text-link" href="/work-stays">Work and long stays</a></p>
        </section>

        <section class="block" aria-labelledby="arriving">
          <h2 id="arriving">Arriving and leaving</h2>
          <dl class="arrive">
            <div>
              <dt>Check-in</dt>
              <dd class="arrive__time">{clock(booking.checkInTime)}</dd>
            </div>
            <div>
              <dt>Checkout</dt>
              <dd class="arrive__time">{clock(booking.checkOutTime)}</dd>
            </div>
            <div class="arrive__text">
              <dt>Entry</dt>
              <dd>Self check-in, keys in a lockbox</dd>
            </div>
            <div class="arrive__text">
              <dt>Access</dt>
              <dd>Top floor, stairs to the front door, no lift</dd>
            </div>
          </dl>
          <p class="arrive__sentence">Self check-in with keys in a lockbox. The flat is on the top floor, up a flight of stairs with no lift.</p>
          <p class="body">We send the address and the lockbox code 48 hours before you arrive.</p>
          {
            extrasLine.length > 0 && (
              <p class="body">
                You can add {listJoin(extrasLine)} when you book. Early check-in and late checkout depend on the nights either side being free.
              </p>
            )
          }
        </section>

        <section class="block" aria-labelledby="rules">
          <h2 id="rules">House rules</h2>
          <p class="body">{rulesText}</p>
          <p class="block__more"><a class="text-link" href="/house-rules">Full house rules</a></p>
        </section>

        <section class="block" aria-labelledby="know">
          <h2 id="know">Good to know</h2>
          <ul class="known">
            {p.goodToKnow.map((g) => <li>{g}</li>)}
          </ul>
        </section>

        <section class="block" aria-labelledby="cancel">
          <h2 id="cancel">Cancellation</h2>
          <p class="body">
            Full refund if you cancel more than {booking.freeCancellationDays} days before check-in.
            {todo.lateCancellation && <>{todo.lateCancellation} </>}
            <a href="/terms">Booking terms</a>
          </p>
        </section>

        <section class="block" aria-labelledby="location">
          <h2 id="location">Where it is</h2>
          <p class="body">
            {p.area}, {p.postcodeArea}. {p.overview[2]} We send the exact address 48 hours before you arrive.
          </p>
          <AreaMap property={p} href={mapsHref} />
          <p class="distances"><Fragment set:html={dotted(distances)} /></p>
          <p class="block__more"><a class="text-link" href={`/areas/${p.areaSlug}`}>Our {p.area} guide</a></p>
        </section>

        {
          p.reviews.length > 0 && (
            <section class="block" id="reviews" aria-labelledby="reviews-title">
              <h2 id="reviews-title">Reviews</h2>
              <Reviews reviews={p.reviews} />
            </section>
          )
        }
      </div>

      <BookingPanel property={p} />
    </div>
  </div>

  <StickyBar variant="bar" price={p.fromPriceFallback} href="#book" />

  <dialog class="viewer" data-photos aria-labelledby="viewer-title">
    <div class="viewer__head">
      <div class="container viewer__bar">
        <p class="viewer__title" id="viewer-title">All {existing.length} photos</p>
        <nav class="viewer__rooms" aria-label="Rooms">
          {rooms.map((room) => <a href={`#${roomId(room)}`} data-room>{room}</a>)}
        </nav>
        <button type="button" class="viewer__close" aria-label="Close photos" data-close-photos>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    </div>
    <div class="container">
      {
        rooms.map((room) => {
          // TV shots after the others, so the lightbox never opens on one
          const inRoom = existing.filter((ph) => ph.room === room);
          const shots = [...inRoom.filter((ph) => !ph.tv), ...inRoom.filter((ph) => ph.tv)];
          return (
            <section class="viewer__room" id={roomId(room)} aria-labelledby={`${roomId(room)}-h`}>
              <h2 class="viewer__h" id={`${roomId(room)}-h`}>
                {room} <span class="viewer__n">{plural(shots.length, 'photo')}</span>
              </h2>
              <div class="viewer__grid">
                {shots.map((ph) => (
                  <Photo slug={p.slug} file={ph.file} alt={ph.alt} ratio="auto" sizes="(min-width: 900px) 520px, 100vw" />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </dialog>
</Base>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('[data-photos]');
  // "All photos" opens at the top; a room card's button opens at that room
  document.querySelectorAll<HTMLElement>('[data-open-photos]').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!viewer) return;
      viewer.showModal();
      const room = btn.dataset.openPhotos && document.getElementById(btn.dataset.openPhotos);
      room ? room.scrollIntoView({ block: 'start' }) : viewer.scrollTo(0, 0);
    }),
  );
  document.querySelector('[data-close-photos]')?.addEventListener('click', () => viewer?.close());
  // Room links scroll inside the dialog without touching the address bar
  viewer?.querySelectorAll<HTMLAnchorElement>('[data-room]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById(a.hash.slice(1))?.scrollIntoView({ block: 'start' });
    }),
  );

  // Back goes back when the guest came from this site, otherwise home
  document.querySelector('[data-back]')?.addEventListener('click', (e) => {
    if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  });
</script>

<style>
  .stay {
    background: var(--paper);
    color: var(--ink);
  }
  .stay h1,
  .stay h2 {
    color: var(--forest);
  }

  /* 1. Gallery. Phones: a full-width swipe row at 4:5, back button and counter over it.
     From 900px the same track becomes the 2fr 1fr 1fr grid of the first five, every cell filled. */
  .top {
    padding-top: var(--header-h);
  }
  @media (max-width: 899.98px) {
    .top {
      padding-inline: 0;
    }
  }

  .gallery__back,
  .gallery__all {
    position: absolute;
    z-index: 1;
    background: var(--paper);
    color: var(--forest);
  }
  .gallery__back {
    top: 12px;
    left: max(12px, env(safe-area-inset-left));
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .gallery__all {
    bottom: 12px;
    left: 12px;
    min-height: 36px;
    padding: 6px 16px;
    border: 0;
    border-radius: var(--r-pill);
    font: inherit;
    font-size: var(--t-small);
    font-weight: 500;
    cursor: pointer;
  }
  .gallery__all:hover {
    background: var(--forest);
    color: var(--paper);
  }
  .top :global(.gallery .carousel__count) {
    top: auto;
    bottom: 12px;
    padding: 6px 12px;
  }

  @media (min-width: 900px) {
    .top {
      padding-top: calc(var(--header-h) + var(--s3));
    }
    .gallery__back {
      display: none;
    }
    .gallery__all {
      left: auto;
      right: 16px;
      bottom: 16px;
      min-height: 44px;
      padding: 10px 20px;
    }
    .top :global(.gallery .carousel__track) {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 10px;
      height: 580px;
      overflow: visible;
    }
    .top :global(.gallery .carousel__track > *) {
      aspect-ratio: auto !important;
      height: 100%;
      min-height: 0;
    }
    .top :global(.gallery .carousel__track > :first-child) {
      grid-row: span 2;
    }
    .top :global(.gallery .carousel__track > :nth-child(n + 6)),
    .top :global(.gallery .carousel__nav),
    .top :global(.gallery .carousel__count),
    .top :global(.gallery .carousel__dots) {
      display: none;
    }
  }

  /* 2. Body and booking card */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s6);
    padding-block: var(--s5) var(--section);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--s6);
      padding-top: var(--s8);
    }
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 80px;
    }
  }

  .title h1 {
    margin-bottom: var(--s3);
  }
  .title__line {
    display: block;
  }
  .nowrap,
  .stay :global(.nowrap) {
    white-space: nowrap;
  }
  .title__facts,
  .title__rated,
  .distances {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .title__facts {
    padding-top: 12px;
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .title__rated {
    margin-top: 6px;
    color: var(--forest-soft);
  }
  .title__intro {
    max-width: var(--measure);
    margin-top: var(--s4);
    color: var(--text-2);
  }
  @media (min-width: 900px) {
    .title__intro {
      font-size: var(--t-lead);
    }
  }

  .block {
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  .block h2 {
    margin-bottom: var(--s3);
    font-size: var(--t-h3);
    line-height: 1.1;
  }
  .body {
    max-width: var(--measure);
  }
  .block__more {
    margin: var(--s2) 0 0;
  }
  @media (min-width: 900px) {
    .block {
      margin-top: var(--s6);
      padding-top: var(--s6);
    }
  }

  /* Where you'll sleep: the room cards as plain 4:5 tiles, swiping at 62% on phones */
  .sleep {
    container-type: inline-size;
  }
  .rooms {
    display: flex;
    gap: 12px;
    margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
    scrollbar-width: none;
  }
  .rooms::-webkit-scrollbar {
    display: none;
  }
  .rooms > :global(*) {
    flex: 0 0 62%;
    scroll-snap-align: start;
  }
  @container (min-width: 600px) {
    .rooms {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s2);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
  .rooms :global(.photo-card) {
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: none;
  }
  .rooms :global(.photo-card .photo) {
    aspect-ratio: 4 / 5 !important;
  }
  .rooms :global(.photo-card__body) {
    padding: 14px 0 0;
  }
  .rooms :global(.photo-card__name) {
    font-size: 1.5rem;
  }
  .rooms :global(.photo-card__bed) {
    margin-bottom: 12px;
  }
  .rooms :global(.photo-card__foot) {
    padding-top: 4px;
  }

  /* What's in the flat: two columns of the schedule, keys narrower than the page default */
  .stay :global(.amenities) {
    --key-w: 96px;
  }

  /* Arriving and leaving: cells between forest rules */
  .arrive {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 0 var(--s3);
    border-block: 1px solid var(--line-strong);
  }
  .arrive div {
    padding: 14px 16px 16px 0;
  }
  .arrive div + div {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .arrive dt {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--forest-soft);
  }
  .arrive dd {
    margin: 0;
  }
  .arrive__time {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--forest);
  }
  .arrive__text {
    display: none;
  }
  @media (min-width: 900px) {
    .arrive {
      grid-template-columns: 0.8fr 0.8fr 1fr 1.2fr;
    }
    .arrive__text {
      display: block;
    }
    .arrive__sentence {
      display: none;
    }
  }

  /* Good to know: ruled rows like a schedule, without keys */
  .known {
    max-width: 44em;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .known li {
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .distances {
    color: var(--forest-soft);
  }
  .stay :global(.map) {
    margin-bottom: var(--s2);
  }

  /* Lightbox */
  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 0 var(--s8);
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overscroll-behavior: contain;
  }
  .viewer::backdrop {
    background: var(--paper);
  }
  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }
  .viewer__head {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .viewer__bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 68px;
  }
  .viewer__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--forest);
  }
  .viewer__rooms {
    display: none;
  }
  .viewer__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--forest);
    cursor: pointer;
  }
  .viewer__close:hover {
    border-color: var(--forest);
  }
  .viewer__room {
    padding-top: var(--s5);
