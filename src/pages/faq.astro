---
import Base from '../layouts/Base.astro';
import Accordion from '../components/ui/Accordion.astro';
import { site } from '../config/site';
import { faqGroups } from '../data/faq';
import { faqPage } from '../lib/schema';
---

<Base
  title="FAQ"
  description="Answers on booking, payment, cancellation, check-in and work stays at Two Rivers Living."
  schema={[faqPage(faqGroups.flatMap((g) => g.items))]}
>
  <div class="container page-head">
    <h1>Questions and answers</h1>
    <p>Can't find what you need? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div>

  {
    faqGroups.map((g, i) => (
      <section class="section section--ruled" aria-labelledby={`group-${i}`}>
        <div class="container split">
          <h2 id={`group-${i}`}>{g.title}</h2>
          <Accordion items={g.items} openFirst={i === 0} />
        </div>
      </section>
    ))
  }
</Base>
