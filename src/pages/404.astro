---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="container narrow page-head notfound">
    <img src="/brand/mark.svg" alt="" width="64" height="40" />
    <h1>We can't find that page</h1>
    <p>The link may be old, or the address mistyped.</p>
    <p class="links">
      <a class="button" href="/stays">See our stays</a>
      <a class="button button--ghost" href="/">Home</a>
    </p>
  </div>
</Base>

<style>
  .notfound {
    padding-bottom: var(--section);
  }
  .notfound img {
    width: 64px;
    height: auto;
    margin-bottom: var(--s4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
</style>
