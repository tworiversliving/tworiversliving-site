---
import Base from '../layouts/Base.astro';
import Schedule from '../components/ui/Schedule.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../config/site';
import { todo } from '../data/todo';
---

<Base title="Contact" description={`Get in touch with ${site.hosts} at ${site.name}. ${site.responseTime}`}>
  <div class="container page-head">
    <h1>Get in touch</h1>
    <p>We reply within a few hours, between 8am and 10pm.</p>
  </div>

  <section class="section section--ruled">
    <div class="container layout">
      <div>
        <h2 class="visually-hidden">Send us a message</h2>
        <EnquiryForm type="contact" />
      </div>

      <aside class="details" aria-labelledby="other-title">
        <h2 id="other-title" class="h3">Other ways to reach us</h2>
        <Schedule
          rows={[
            { key: 'Email', value: site.email, href: `mailto:${site.email}` },
            { key: 'WhatsApp', value: todo.whatsapp, href: todo.whatsappHref || undefined },
            { key: 'Post', value: `${site.legalName}, ${site.correspondenceAddress}` },
          ]}
        />
        <p class="details__note">Booking a work or long stay? The <a href="/work-stays#quote">quote form</a> asks for everything we need.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--s8);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 7fr) 5fr;
      gap: var(--s8);
    }
  }
  .details h2 {
    margin-bottom: var(--s3);
  }
  .details__note {
    margin-top: var(--s3);
    font-size: var(--t-small);
    color: var(--text-3);
  }
</style>
