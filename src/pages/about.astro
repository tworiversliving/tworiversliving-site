---
import Base from '../layouts/Base.astro';
import Photo from '../components/ui/Photo.astro';
import Button from '../components/ui/Button.astro';
import Schedule from '../components/ui/Schedule.astro';
import { site } from '../config/site';
import { properties } from '../data/properties';

const flat = properties[0];
// No hosts photo yet: renders as a toned block until hosts.jpg is added to the property folder.
const hosts = { file: 'hosts.jpg', alt: `${site.hosts}, the hosts` };
---

<Base title="About us" description={`${site.name} is run by ${site.hosts}, two locals who were born and raised in Stoke Newington.`}>
  <div class="container page-head">
    <p class="label">Named for the two rivers our families come from</p>
    <h1>Two locals, looking after homes in the area we <em>grew up in</em></h1>
  </div>

  <section class="section section--ruled">
    <div class="container story">
      <Photo slug={flat.slug} file={hosts.file} alt={hosts.alt} ratio="4/5" sizes="(min-width: 900px) 460px, 100vw" />
      <div class="story__text">
        <p class="lead">
          We're {site.hosts}. We were born and raised in Stoke Newington and still live a few minutes from the flat. We started
          {site.name} to give visitors the kind of place we'd want to stay in ourselves.
        </p>
        <p>
          We host it ourselves. Check-in is with a lockbox, so you can arrive when it suits you, and one of us is always on call if
          anything comes up. Every guest gets our own guidebook to the area: the places we actually go.
        </p>
        <p>
          Every home we take on has private bedrooms with proper beds, a kitchen you can cook a real meal in, a desk to work at, and
          wifi throughout. If it isn't somewhere we'd stay, we don't list it.
        </p>
        <Schedule
          class="story__facts"
          rows={[
            { key: 'Born', value: 'Stoke Newington' },
            { key: 'Live', value: 'A few minutes away' },
            { key: 'Reply', value: '8am to 10pm' },
          ]}
        />
        <p class="story__links">
          <Button href={`/stays/${flat.slug}`}>See the flat</Button>
          <Button href="/contact" variant="secondary">Get in touch</Button>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    gap: var(--s5);
  }
  .story__text {
    max-width: var(--measure);
  }
  .story__text p:not(.lead) {
    color: var(--text-2);
  }
  .story :global(.story__facts) {
    margin-top: var(--s5);
  }
  .story__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: var(--s5) 0 0;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 5fr 7fr;
      gap: var(--s8);
      align-items: start;
    }
  }
</style>
